    <element xsi:type="archimate:Capability" name="Planeación y Dirección Estratégica" id="id-e-0001">
      <documentation>Fijar el rumbo de la inmobiliaria y las políticas corporativas. La gerente general aprueba las políticas; hoy nunca ha aprobado una sobre datos.</documentation>
      <property key="Nivel" value="Nivel 1" />
      <property key="Tipo de capacidad" value="Estratégica" />
      <property key="Rol estratégico (empresa)" value="Soporte" />
      <property key="Subdominio DDD (solución Tema 2)" value="N/A (fuera de la solución)" />
      <property key="Impacto de la solución" value="Indirecto" />
      <property key="Madurez actual (según entrevista)" value="No evaluada" />
      <property key="Estado de validación" value="Respaldada por la entrevista" />
    </element>
    <element xsi:type="archimate:Capability" name="Definición de estrategia y políticas corporativas" id="id-e-0002">
