  <element xsi:type="archimate:Meaning" name="Atributo de negocio: concepto de la herramienta (C2)" id="id-ebac4d83e8844c7dab12424312226100">
      <documentation>Significado en C2 (V7b).</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Atributo de negocio: columna del sistema fuente (C1)" id="id-c970b25a3d8740179b7d8831b216d7d7">
      <documentation>Significado en el contexto del sistema fuente (V7b).</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Un atributo se documenta una sola vez aunque esté en varias columnas o sistemas; las columnas equivalentes se consolidan" id="id-eeb4d86b4b2c41ff8418a250f85d7662">
      <documentation>Fuente: Contratos 4.1 y 3.3, V7.</documentation>
      <property key="Fuente" value="Contratos 4.1 y 3.3, V7" />
    </element>
    <element xsi:type="archimate:Requirement" name="Todo atributo con datos personales exige responsable (política entre C2 y C4)" id="id-245d2d25de294bbbabd05356e7aff8a2">
      <documentation>Fuente: V6.b, contrato 3.5, decisión de la Fase 5.</documentation>
      <property key="Fuente" value="V6.b, contrato 3.5, decisión de la Fase 5" />
    </element>
    <element xsi:type="archimate:Constraint" name="La expresión regular se valida solo en su sintaxis y no se ejecuta contra datos" id="id-645436f6b69b44f5ab9076293577ae42">
      <documentation>Fuente: Contrato 4.4, V6.b.</documentation>
      <property key="Fuente" value="Contrato 4.4, V6.b" />
    </element>
    <element xsi:type="archimate:Constraint" name="La herramienta documenta metadatos y no modifica los registros de las fuentes" id="id-82a59948bd2e4463a374e6c2f01cd321">
      <documentation>Fuente: V6.b, principio P3.</documentation>
      <property key="Fuente" value="V6.b, principio P3" />
    </element>
    <element xsi:type="archimate:Requirement" name="Cada cambio de un atributo crea una versión" id="id-d7efac2dd37f435c869a348c876de442">
      <documentation>Fuente: Contrato 4.1.</documentation>
      <property key="Fuente" value="Contrato 4.1" />
    </element>
    <element xsi:type="archimate:Constraint" name="Un atributo solo se carga si su fuente existe en C1" id="id-b1322402eddd410dbad31b0c31882c56">
      <documentation>Fuente: Decisión de la Fase 5.</documentation>
      <property key="Fuente" value="Decisión de la Fase 5" />
    </element>
    <element xsi:type="archimate:Requirement" name="Lo faltante o dudoso se muestra como tal, nunca como correcto" id="id-583310f736744669990e740d661cf247">
      <documentation>Fuente: Principio P2.</documentation>
      <property key="Fuente" value="Principio P2" />
    </element>
    <element xsi:type="archimate:Requirement" name="La definición es obligatoria al registrar el metadato de negocio (contrato 4.4), pero el atributo puede existir antes sin metadato y queda incompleto (V6.b)" id="id-2c470d1211e04ec599f15fc059f63c40">
      <documentation>Fuente: V6.b, contrato 4.4.</documentation>
      <property key="Fuente" value="V6.b, contrato 4.4" />
    </element>
