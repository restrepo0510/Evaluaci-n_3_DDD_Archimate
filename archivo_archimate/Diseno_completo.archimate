    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de depuración y deduplicación de datos" id="id-merge-f4e61fad6a8a4780babfa1557a35d223">
      <documentation>Fuera de alcance; exige datos personales. El 8 % de propietarios duplicados queda sin atender.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Fuera de alcance; exige datos personales. El 8 % de propietarios duplicados queda sin atender." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de gestión de datos maestros" id="id-merge-6aff935d9db24b6885f5498e3ef695a9">
      <documentation>Fuera de alcance. Solucionaría la duplicidad, pero es otro proyecto.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Fuera de alcance. Solucionaría la duplicidad, pero es otro proyecto." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de gestión de autorizaciones de titulares" id="id-merge-be712a66617e46d99b9ead14fd9a759f">
      <documentation>Fuera del alcance de los cinco puntos; hoy son formatos dispersos. Candidato a otra solución.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Fuera del alcance de los cinco puntos; hoy son formatos dispersos. Candidato a otra solución." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de trámite de reclamos de titulares" id="id-merge-6bad0d924efa4f9f914d91787563be5a">
      <documentation>La solución solo informa dónde están los datos. El trámite sigue en Jurídica y Servicio al cliente.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="La solución solo informa dónde están los datos. El trámite sigue en Jurídica y Servicio al cliente." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de gestión de incidentes con datos personales" id="id-merge-7f029176fcec4b73a73a8ecc1826f45d">
      <documentation>Fuera de alcance; no hay procedimiento definido.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Fuera de alcance; no hay procedimiento definido." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de gestión de encargados del tratamiento (proveedores)" id="id-merge-53e5736ce81141259c887f573aee3313">
      <documentation>Fuera de alcance; las cláusulas de datos con proveedores siguen pendientes con la gerente.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Fuera de alcance; las cláusulas de datos con proveedores siguen pendientes con la gerente." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de retención y supresión de datos" id="id-merge-d02c9ec13ab04528854b2be12a0da3ab">
      <documentation>Fuera de alcance; consumirá el diccionario cuando exista.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Fuera de alcance; consumirá el diccionario cuando exista." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de transmisión del reporte a la SIC" id="id-merge-8d707e9764944fbe9c8237843d009e0e">
      <documentation>Formato, canal y plazos por verificar, y la obligación misma es incierta. Se exporta el informe y Jurídica lo presenta.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Formato, canal y plazos por verificar, y la obligación misma es incierta. Se exporta el informe y Jurídica lo presenta." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de linaje de datos" id="id-merge-6ee1d7478fd64ebf8fc5429c25abffe8">
      <documentation>No fue solicitado y las hojas y carpetas no tienen catálogo técnico que lo permita.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="No fue solicitado y las hojas y carpetas no tienen catálogo técnico que lo permita." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de aprobación de políticas de datos" id="id-merge-96fa54eb0487497d917a4536e49398aa">
      <documentation>Decide la gerente fuera de la herramienta; el diccionario solo referencia las vigentes.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Decide la gerente fuera de la herramienta; el diccionario solo referencia las vigentes." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de directorio e identidad corporativa (SSO)" id="id-merge-466f9c2d1bab40efb7d00d97437b1a3e">
      <documentation>La empresa no tiene uno; los roles se manejan localmente en el servicio de control de acceso.</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="La empresa no tiene uno; los roles se manejan localmente en el servicio de control de acceso." />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de integración con portales, aseguradora, banco, notarías y centrales de riesgo" id="id-merge-c0f3936f001c4d0595678fae9775162d">
      <documentation>Reciben datos del negocio, pero no intercambian información con la herramienta. Se podrían registrar como destinatarios del atributo (extensión futura).</documentation>
      <property key="Capa" value="Fuera de la solución" />
      <property key="Decisión" value="Excluido" />
      <property key="Justificación" value="Reciben datos del negocio, pero no intercambian información con la herramienta. Se podrían registrar como destinatarios del atributo (extensión futura)." />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de gestión del acceso a metadatos técnicos" id="id-merge-dfa293b1017c4df49092ce455fa06538">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de gestión del acceso a metadatos técnicos" />
      <property key="Operaciones" value="solicitarAcceso(fuente); registrarAutorizacion(fuente, autorizador); registrarCuentaSoloLectura(fuente); revocarAcceso(fuente)" />
      <property key="Entrada" value="fuente, autorizador, ejecutor (TI o proveedor)" />
      <property key="Salida" value="constancia: quién autorizó, quién ejecutó, cuándo y alcance" />
      <property key="Reglas de negocio" value="Solo lectura, cuenta propia, sin acceso a datos de personas. En S2 el proveedor entrega; la empresa no tiene credenciales" />
      <property key="Excepciones" value="Sin autorización no se habilita la importación" />
      <property key="Consumidores" value="Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de importación de metadatos técnicos" id="id-merge-b656e8274bd849ad81dc4c7386921221">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de importación de metadatos técnicos" />
      <property key="Operaciones" value="importarEstructura(fuente); reintentarImportacion(fuente); consultarEstadoImportacion(fuente)" />
      <property key="Entrada" value="fuente autorizada y su origen (conexión o entrega del proveedor)" />
      <property key="Salida" value="metadatos técnicos versionados y resumen de nuevos y cambiados" />
      <property key="Reglas de negocio" value="Solo estructura. Se conserva la última versión y se anota su fecha" />
      <property key="Excepciones" value="Fuente no disponible: se reintenta y se trabaja con la última versión conocida" />
      <property key="Consumidores" value="Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de inventario de atributos de negocio" id="id-merge-22404924000d43629807f499e66e51d8">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de inventario de atributos de negocio" />
      <property key="Operaciones" value="inventariarAtributos(fuente); registrarAtributoManual(datos); vincularColumna(atributo, columna)" />
      <property key="Entrada" value="columnas importadas o lista manual" />
      <property key="Salida" value="atributos de negocio y cobertura por fuente" />
      <property key="Reglas de negocio" value="Columnas equivalentes se consolidan en un atributo. Lo no inventariado se muestra como 'área sin cubrir'" />
      <property key="Excepciones" value="Fuente sin inventario: queda 'sin cubrir'" />
      <property key="Consumidores" value="Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de registro de metadatos de negocio" id="id-merge-835ceaf4bc8e4b8b96ac1b23135271d9">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de registro de metadatos de negocio" />
      <property key="Operaciones" value="registrarMetadatosNegocio(atributo, definición, calidad, regex); solicitarCompletar(atributo)" />
      <property key="Entrada" value="atributo, definición, política de calidad, expresión regular" />
      <property key="Salida" value="metadato registrado o atributo marcado incompleto" />
      <property key="Reglas de negocio" value="La regex debe ser válida y no se ejecuta contra datos. Si falta algo, el atributo queda incompleto y lo ve el oficial" />
      <property key="Excepciones" value="Dato faltante: marcado incompleto, nunca se completa por defecto" />
      <property key="Consumidores" value="Responsable de dato de área" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de asignación de responsables de datos" id="id-merge-65008e4a243c4f16bba19c576553e31b">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de asignación de responsables de datos" />
      <property key="Operaciones" value="asignarResponsable(atributo, responsable); reasignarResponsable(atributo, responsable); listarSinResponsable()" />
      <property key="Entrada" value="atributo, responsable, jefatura que designa" />
      <property key="Salida" value="asignación vigente con histórico" />
      <property key="Reglas de negocio" value="Un atributo con datos personales debe tener responsable. La reasignación conserva el histórico" />
      <property key="Excepciones" value="Sin responsable: aparece en la alerta al oficial" />
      <property key="Consumidores" value="Administrador del diccionario; Gerente general" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de clasificación de atributos" id="id-merge-1d39d33f3c0f4b289f0d7ee5f66e08ac">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de clasificación de atributos" />
      <property key="Operaciones" value="proponerClasificacion(atributo, categoría, criterio, justificación); marcarEnRevision(atributo, opinión); consultarPendientes()" />
      <property key="Entrada" value="atributo, categoría, criterio, justificación, fuente normativa" />
      <property key="Salida" value="clasificación en estado propuesta o en revisión" />
      <property key="Reglas de negocio" value="Categorías según el marco normativo (por verificar). Si hay discusión queda 'en revisión' con la opinión de cada parte" />
      <property key="Excepciones" value="Sin justificación no se guarda" />
      <property key="Consumidores" value="Oficial de protección de datos" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de validación jurídica de la clasificación" id="id-merge-4188f6769f364e999ff75c55275c6029">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de validación jurídica de la clasificación" />
      <property key="Operaciones" value="validar(clasificación, justificación); objetar(clasificación, motivo); consultarPendientes()" />
      <property key="Entrada" value="clasificación propuesta, decisión, justificación, fuente normativa" />
      <property key="Salida" value="clasificación validada u objetada" />
      <property key="Reglas de negocio" value="La valida solo Jurídica o el oficial. Se revisa de nuevo si cambia el uso del dato o la norma" />
      <property key="Excepciones" value="Sin validar: no se presenta como definitiva" />
      <property key="Consumidores" value="Abogada interna; Oficial de protección de datos" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de publicación del diccionario de datos" id="id-merge-627746200257431c81f09b7a90673342">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de publicación del diccionario de datos" />
      <property key="Operaciones" value="publicarVersion(); consultarVersionPublicada(); compararVersiones(a, b)" />
      <property key="Entrada" value="ninguna (toma el estado vigente)" />
      <property key="Salida" value="versión publicada del diccionario con fecha" />
      <property key="Reglas de negocio" value="Publica todo, pero marca los atributos incompletos y la antigüedad de la información técnica" />
      <property key="Excepciones" value="Atributos incompletos se muestran como tales" />
      <property key="Consumidores" value="Todos los roles con permiso de consulta" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de gestión del catálogo de términos de negocio" id="id-merge-706d257a0f194155bd7667dd73d2fc4a">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de gestión del catálogo de términos de negocio" />
      <property key="Operaciones" value="proponerTermino(término, significado); aprobarTermino(término); asociarAtributos(término, atributos); resolverConflicto(término)" />
      <property key="Entrada" value="término, significado, área, atributos" />
      <property key="Salida" value="término vigente o en conflicto con sus atributos" />
      <property key="Reglas de negocio" value="Dos significados se registran ambos y se marca el conflicto. Cada término se asocia a uno o más atributos" />
      <property key="Excepciones" value="Término sin atributos: advertencia" />
      <property key="Consumidores" value="Responsable de dato de área; Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de control de cambios de estructura" id="id-merge-998d47b5163d4802a12aaa15540f4136">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de control de cambios de estructura" />
      <property key="Operaciones" value="detectarCambios(fuente); notificarCambio(cambio); registrarImpacto(cambio)" />
      <property key="Entrada" value="dos versiones de la estructura técnica" />
      <property key="Salida" value="lista de cambios y avisos a los roles afectados" />
      <property key="Reglas de negocio" value="Un cambio sobre un atributo sensible se marca de riesgo. El cambio no altera la clasificación por sí solo" />
      <property key="Excepciones" value="Sin versión previa: se registra como línea base" />
      <property key="Consumidores" value="Coordinador de TI; Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de ubicación de datos personales" id="id-merge-6fd17f07aef54bcaa90eba99b35f4183">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de ubicación de datos personales" />
      <property key="Operaciones" value="listarAtributosPersonales(filtro); ubicarAtributo(atributo); sistemasConDatosDeTipoDeTitular(tipo)" />
      <property key="Entrada" value="filtro (categoría, sistema) o tipo de titular (propietario, arrendatario, codeudor, interesado)" />
      <property key="Salida" value="atributos con categoría, ubicación y responsable, más faltantes" />
      <property key="Reglas de negocio" value="Responde por atributo y tipo de titular, no por persona: la herramienta no guarda datos de personas" />
      <property key="Excepciones" value="Dato incompleto: se indica qué falta" />
      <property key="Consumidores" value="Oficial de protección de datos" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de información para seguridad de la información" id="id-merge-13e6bd13b82c457d95be7e43ab63d292">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de información para seguridad de la información" />
      <property key="Operaciones" value="listarAtributosSensibles(); listarSistemasDeRiesgo(); listarCambiosDeRiesgo(); listarSinResponsable()" />
      <property key="Entrada" value="filtros opcionales" />
      <property key="Salida" value="listas para controles de seguridad" />
      <property key="Reglas de negocio" value="Solo atributos sensibles y privados; sin datos de personas" />
      <property key="Excepciones" value="Clasificación sin validar: se indica" />
      <property key="Consumidores" value="Coordinador de TI" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de información para el reporte regulatorio" id="id-merge-8893983bc6284b2e84b066c8c9052bef">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de información para el reporte regulatorio" />
      <property key="Operaciones" value="prepararInforme(parámetros); validarCompletitud(informe); exportarInforme(informe, formato)" />
      <property key="Entrada" value="parámetros del reporte (por verificar)" />
      <property key="Salida" value="informe con bases, finalidad, responsable y encargado, tipos de datos, clasificación, medidas y titulares aproximados" />
      <property key="Reglas de negocio" value="No se transmite: lo presenta Jurídica. Formato, canal y plazos por verificar" />
      <property key="Excepciones" value="Información no validada: no se presenta como definitiva" />
      <property key="Consumidores" value="Abogada interna; Abogado externo" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de seguimiento de completitud de atributos" id="id-merge-dde86c6271134c3dae38b30df00e0daa">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de seguimiento de completitud de atributos" />
      <property key="Operaciones" value="calcularCobertura(); listarIncompletos(); listarSinClasificar()" />
      <property key="Entrada" value="ninguna" />
      <property key="Salida" value="porcentaje de atributos con responsable, con regla de calidad y con clasificación documentada, más listas" />
      <property key="Reglas de negocio" value="Los indicadores salen del Bloque 7; el cálculo es sobre atributos, no sobre datos" />
      <property key="Excepciones" value="Sin atributos inventariados: cobertura no calculable" />
      <property key="Consumidores" value="Oficial de protección de datos; Responsable de dato de área" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de atributo de negocio" id="id-merge-7ae2f37fe6e543939368deb99dd111e3">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de atributo de negocio" />
      <property key="Operaciones" value="crearAtributo(datos); consultarAtributo(id); modificarAtributo(id, datos); listarAtributos(filtro); obtenerVersiones(id)" />
      <property key="Entrada" value="nombre de negocio, descripción breve, origen" />
      <property key="Salida" value="atributo con id, estado de completitud y versión" />
      <property key="Reglas de negocio" value="Un atributo puede mapearse a varias columnas. Cada cambio crea versión. Es 'incompleto' si falta definición, responsable o clasificación" />
      <property key="Excepciones" value="Duplicado: advertir y no crear. Inexistente: error de no encontrado" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de metadato técnico" id="id-merge-6a9fb4fd2fb344f383bf38f33e5b0b1e">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de metadato técnico" />
      <property key="Operaciones" value="registrarEstructura(fuente, versión, columnas); consultarMetadatoTecnico(atributo); listarVersiones(fuente)" />
      <property key="Entrada" value="fuente, tabla, columna, tipo, longitud, obligatoriedad, fecha de captura" />
      <property key="Salida" value="metadato técnico versionado con fecha" />
      <property key="Reglas de negocio" value="Solo estructura. Se conserva la versión anterior y se muestra la fecha" />
      <property key="Excepciones" value="Fuente sin importación reciente: se devuelve lo último con su fecha" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de fuente de datos" id="id-merge-e2209bb9ed80451293c11e3035894f7e">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de fuente de datos" />
      <property key="Operaciones" value="registrarFuente(datos); consultarFuente(id); registrarAutorizacion(fuente, autorizador); listarFuentes(filtro)" />
      <property key="Entrada" value="nombre, tipo (motor, hoja, carpeta, canal), responsable, autorizador" />
      <property key="Salida" value="fuente con estado de cobertura (importada, manual, sin cubrir)" />
      <property key="Reglas de negocio" value="Toda fuente tiene autorizador y constancia de acceso. La no inventariada es 'área sin cubrir'" />
      <property key="Excepciones" value="Sin autorizador no se habilita la importación" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de metadato de negocio" id="id-merge-3b7e8e573c8046348f359c4dc665073b">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de metadato de negocio" />
      <property key="Operaciones" value="registrarMetadatoNegocio(atributo, datos); consultar(atributo); modificar(atributo, datos); validarExpresion(regex)" />
      <property key="Entrada" value="atributo, definición, política de calidad, expresión regular" />
      <property key="Salida" value="metadato de negocio con estado de completitud" />
      <property key="Reglas de negocio" value="Definición obligatoria. La regex se valida sintácticamente y no se ejecuta contra datos" />
      <property key="Excepciones" value="Regex inválida: se rechaza con mensaje. Sin definición: atributo incompleto" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de responsable de dato" id="id-merge-6ead4ed0f61b4e4f933d43b3deac44b9">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de responsable de dato" />
      <property key="Operaciones" value="asignar(atributo, responsable); reasignar(atributo, responsable); consultar(atributo); listarSinResponsable()" />
      <property key="Entrada" value="atributo, responsable (rol, persona o área), quién designa" />
      <property key="Salida" value="asignación vigente con histórico" />
      <property key="Reglas de negocio" value="Todo atributo con datos personales requiere responsable" />
      <property key="Excepciones" value="Sin responsable: alerta al oficial" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de clasificación de atributo" id="id-merge-5327586ea4804d55a27597f2811fb9d6">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de clasificación de atributo" />
      <property key="Operaciones" value="proponer(atributo, categoría, criterio, justificación); registrarValidacion(id, decisión); marcarEnRevision(id, opinión); consultar(atributo); listarPendientes()" />
      <property key="Entrada" value="atributo, categoría (pública, semiprivada, privada, sensible, no personal), criterio, justificación, fuente normativa, autor" />
      <property key="Salida" value="clasificación con estado (propuesta, en revisión, validada), versión y fecha" />
      <property key="Reglas de negocio" value="Se propone añadir la categoría 'no personal'. Validada solo por Jurídica u oficial. Reclasificar crea versión" />
      <property key="Excepciones" value="Sin justificación no se guarda; sin validar no es definitiva" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de término de negocio" id="id-merge-1b1717ba87084e5da4218f23b8cc0354">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de término de negocio" />
      <property key="Operaciones" value="crearTermino(datos); modificarTermino(id, datos); asociarAtributo(término, atributo); desasociarAtributo(término, atributo); marcarConflicto(término); consultar(término)" />
      <property key="Entrada" value="término, significado, área, atributos" />
      <property key="Salida" value="término con atributos asociados y estado (vigente, en conflicto)" />
      <property key="Reglas de negocio" value="Dos significados se registran ambos y se marca el conflicto" />
      <property key="Excepciones" value="Término sin atributos: advertencia" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de diccionario de datos" id="id-merge-35e161f5b4dc4539ba3444561cc398d3">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de diccionario de datos" />
      <property key="Operaciones" value="consultarDiccionario(filtros); obtenerFichaAtributo(id); listarIncompletos(); buscarPorTermino(término)" />
      <property key="Entrada" value="filtros (fuente, categoría, responsable, estado, término)" />
      <property key="Salida" value="ficha integrada: técnico + negocio + clasificación + responsable + términos + fecha" />
      <property key="Reglas de negocio" value="Solo lectura. Siempre indica qué falta y qué tan antigua es la información técnica" />
      <property key="Excepciones" value="Sin resultados: lista vacía con el criterio aplicado" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de cambio de estructura" id="id-merge-6bd4c06dfc9c4afca9850194e2ed4224">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de cambio de estructura" />
      <property key="Operaciones" value="registrarDiferencias(fuente, versiónA, versiónB); consultarCambios(fuente, rango); marcarRevisado(cambio)" />
      <property key="Entrada" value="dos versiones de estructura técnica" />
      <property key="Salida" value="cambios (agregado, eliminado, tipo o longitud modificados) con fecha de detección" />
      <property key="Reglas de negocio" value="Un cambio sobre un atributo sensible se marca de riesgo. No modifica clasificaciones" />
      <property key="Excepciones" value="Sin versión previa: línea base" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de bitácora y evidencia de decisiones" id="id-merge-a10743badd294b0ea5836c3cd28e72c8">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de bitácora y evidencia de decisiones" />
      <property key="Operaciones" value="registrarEvento(actor, acción, objeto, antes, después); consultarEventos(filtros); exportarEvidencia(filtros)" />
      <property key="Entrada" value="actor, acción, objeto, valores antes y después, fecha" />
      <property key="Salida" value="evento inmutable" />
      <property key="Reglas de negocio" value="Inmutable. Guarda quién autorizó y el criterio de cada decisión" />
      <property key="Excepciones" value="Si no se puede registrar, la operación de origen no se confirma" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de notificación" id="id-merge-95568b31ebb0426a919263d010576d32">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de notificación" />
      <property key="Operaciones" value="programarAviso(tipo, rol, referencia); listarAvisos(rol); marcarAtendido(aviso)" />
      <property key="Entrada" value="tipo (incompleto, en revisión, cambio de estructura, sin responsable), rol destinatario, referencia" />
      <property key="Salida" value="aviso con estado" />
      <property key="Reglas de negocio" value="Los avisos van por rol y nunca incluyen datos de personas" />
      <property key="Excepciones" value="Canal no disponible: el aviso queda pendiente en la aplicación" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de control de acceso por rol" id="id-merge-ad769554f0a7414f8692aca94b02536a">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de control de acceso por rol" />
      <property key="Operaciones" value="asignarRol(usuario, rol); verificarPermiso(usuario, operación); listarPermisos(rol)" />
      <property key="Entrada" value="usuario, rol, operación" />
      <property key="Salida" value="permiso concedido o denegado" />
      <property key="Reglas de negocio" value="Roles: administrador, responsable de dato, oficial, jurídica, TI, consulta. El diccionario es información sensible" />
      <property key="Excepciones" value="Sin permiso: se deniega y se registra en la bitácora" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de informes y exportación" id="id-merge-95e5b8f32bf4400488237ef92c910978">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de informes y exportación" />
      <property key="Operaciones" value="generarInforme(tipo, parámetros); exportar(informe, formato)" />
      <property key="Entrada" value="tipo de informe, filtros" />
      <property key="Salida" value="informe o archivo con fecha y filtros aplicados" />
      <property key="Reglas de negocio" value="Marca qué falta o no está validado. No contiene datos de personas" />
      <property key="Excepciones" value="Información no validada: se rotula 'no definitivo'" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de adaptación de metadatos técnicos de motores relacionales" id="id-merge-343f0ffcb16f48259cb2a10e942f176e">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de adaptación de metadatos técnicos de motores relacionales" />
      <property key="Operaciones" value="leerCatalogo(motor, conexión); traducirAModeloInterno(catálogo)" />
      <property key="Entrada" value="catálogo del sistema del motor: tablas, columnas, tipo, longitud, obligatoriedad, relaciones" />
      <property key="Salida" value="metadatos técnicos en el modelo interno, con tipos normalizados" />
      <property key="Reglas de negocio" value="Solo el catálogo del sistema; nunca tablas de negocio. Cuenta propia de solo lectura" />
      <property key="Excepciones" value="Fallo de conexión: se reintenta y la fuente queda 'desactualizada'" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de adaptación de metadatos técnicos del CRM (S2)" id="id-merge-6c188fe3a37c4fee89662b1360907cb5">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de adaptación de metadatos técnicos del CRM (S2)" />
      <property key="Operaciones" value="recibirEntregaEstructura(entrega); traducirAModeloInterno(entrega)" />
      <property key="Entrada" value="entrega del proveedor del CRM (formato por acordar)" />
      <property key="Salida" value="metadatos técnicos en el modelo interno" />
      <property key="Reglas de negocio" value="La empresa no tiene credenciales propias; se acepta demora de días y se muestra la fecha" />
      <property key="Excepciones" value="Sin entrega: se conserva la última versión con aviso" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de recepción de avisos de cambio de los proveedores" id="id-merge-4d4695e4277548b1a4f5a59c69b496e4">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de recepción de avisos de cambio de los proveedores" />
      <property key="Operaciones" value="recibirAviso(aviso); registrarAviso(aviso, fuente)" />
      <property key="Entrada" value="aviso por correo o formulario: fuente, cambio, fecha prevista" />
      <property key="Salida" value="aviso registrado y asociado a la fuente" />
      <property key="Reglas de negocio" value="No se confía en que el aviso llegue; la detección por diferencias compensa" />
      <property key="Excepciones" value="Aviso sin fuente identificable: queda pendiente de clasificar" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de carga del inventario de fuentes no estructuradas" id="id-merge-953613b5b09247668bcbc344b166bf26">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de carga del inventario de fuentes no estructuradas" />
      <property key="Operaciones" value="validarPlantilla(archivo); cargarInventario(archivo)" />
      <property key="Entrada" value="plantilla con fuente, tipo de dato personal, ubicación y responsable" />
      <property key="Salida" value="atributos y fuentes registrados, marcados como manuales" />
      <property key="Reglas de negocio" value="Carga manual guiada. No se cargan archivos con datos de personas" />
      <property key="Excepciones" value="Plantilla inválida: se rechaza indicando las filas" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de entrega de información al oficial de protección de datos" id="id-merge-5b45e36545fa4e64849a69aa2ac742d0">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de entrega de información al oficial de protección de datos" />
      <property key="Operaciones" value="consultarAtributosPersonales(filtro); consultarPendientes(); consultarCambiosRecientes(rango)" />
      <property key="Entrada" value="filtros" />
      <property key="Salida" value="listado con categoría, ubicación, responsable y faltantes" />
      <property key="Reglas de negocio" value="Solo lectura y sin datos de personas. Muestra qué falta" />
      <property key="Excepciones" value="Clasificación incompleta: se señala" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de entrega de información a seguridad de la información" id="id-merge-85caec837e7e4ef98e803fc1d8cd59e9">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de entrega de información a seguridad de la información" />
      <property key="Operaciones" value="obtenerAtributosSensibles(); obtenerSistemasDeRiesgo(); obtenerCambiosDeRiesgo()" />
      <property key="Entrada" value="filtros" />
      <property key="Salida" value="listas de atributos sensibles y privados, sistemas y cambios" />
      <property key="Reglas de negocio" value="Solo atributos sensibles y privados" />
      <property key="Excepciones" value="Clasificación sin validar: se indica" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de generación del informe para la SIC" id="id-merge-9344463199464cbea8c436c42e9ba817">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de generación del informe para la SIC" />
      <property key="Operaciones" value="generarInformeRegulatorio(parámetros); exportar(informe, formato)" />
      <property key="Entrada" value="parámetros del reporte (por verificar)" />
      <property key="Salida" value="informe exportable" />
      <property key="Reglas de negocio" value="El formato exigido por la SIC está por verificar. La presenta Jurídica de forma manual" />
      <property key="Excepciones" value="Información faltante: se lista como faltante" />
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del servicio de notificación por correo electrónico" id="id-merge-8c34d0cdae9245a8915ad715016e3df6">
      <documentation>Contrato primero (Contract First): especificación del servicio antes de diseñar la capa de aplicaciones.</documentation>
      <property key="Servicio especificado" value="Servicio de notificación por correo electrónico" />
      <property key="Operaciones" value="enviarAviso(destinatario, plantilla, referencia)" />
      <property key="Entrada" value="aviso interno" />
      <property key="Salida" value="acuse de envío" />
      <property key="Reglas de negocio" value="El cuerpo no incluye datos de personas; los destinatarios se definen por rol" />
      <property key="Excepciones" value="Servidor de correo no disponible: el aviso queda pendiente" />
    </element>
    <element xsi:type="archimate:BusinessObject" name="Fuente de datos (copy)" id="id-8e1a12cbc02d4a019577d4cf71b5ec94" />
    <element xsi:type="archimate:BusinessObject" name="Autorización de acceso a metadatos (copy)" id="id-d9d54aa3089e402ba839c4b17e7fa6eb" />
    <element xsi:type="archimate:BusinessObject" name="Metadato técnico (copy)" id="id-77f63c3e4be4447198d9094a66511cea" />
    <element xsi:type="archimate:BusinessObject" name="Cambio de estructura (copy)" id="id-a143e2da11374f1abf06788ef32a49a7" />
    <element xsi:type="archimate:BusinessObject" name="Diccionario de datos (copy)" id="id-980c8d4e341846ccac4cac2f84a5d5d2" />
    <element xsi:type="archimate:Representation" name="Fuente de datos" id="id-c5cdcf230d9342ab97a1caf4315504b9">
      <documentation>Sistema o lugar donde hay datos que deben documentarse. Puede tener diccionario técnico (una base de datos) o no tenerlo (hojas, carpetas, correo, mensajería). Una fuente identificada pero sin inventariar se muestra como área sin cubrir.</documentation>
      <property key="Ejemplo" value="S2, un CRM en la nube, solo entrega su estructura mediante un pedido al proveedor, y las hojas de cálculo no tienen diccionario (Bloque 1)" />
      <property key="Objeto de negocio en la V5" value="Fuente de datos" />
    </element>
    <element xsi:type="archimate:Representation" name="Metadato técnico" id="id-05c0fa6eba794de9a2c23c263ee25e7b">
      <documentation>Descripción de la estructura de una columna en un sistema fuente: tabla, columna, tipo de dato, longitud y obligatoriedad. Se lee del diccionario del motor y no incluye los registros. Es la parte técnica de un atributo de negocio.</documentation>
      <property key="Ejemplo" value="El negocio dice que la cédula tiene hasta 10 dígitos, pero en S2 el campo acepta 20 caracteres, incluidas letras (Bloque 5)" />
      <property key="Objeto de negocio en la V5" value="Metadato técnico" />
    </element>
    <element xsi:type="archimate:Representation" name="Cambio de estructura" id="id-dc4b94b582a049e7800545a22a5c5d6b">
      <documentation>Diferencia detectada entre dos importaciones de una misma fuente: tabla o columna agregada, renombrada o modificada. No es un cambio de clasificación ni de definición.</documentation>
      <property key="Ejemplo" value="El proveedor de S2 renombró una columna y la publicación hacia S4 dejó de actualizar los precios durante tres días (Bloque 5)" />
      <property key="Objeto de negocio en la V5" value="Cambio de estructura" />
    </element>
    <element xsi:type="archimate:Representation" name="Importación" id="id-f1ab80218a5445629eefbe0f769424be">
      <documentation>Lectura de la estructura técnica de una fuente para traerla a la herramienta. Solo trae estructura, nunca registros con datos de personas.</documentation>
      <property key="Ejemplo" value="S2 tarda días en entregar su estructura, y el negocio acepta tener esa fuente desactualizada si se sabe (Bloque 8)" />
    </element>
    <element xsi:type="archimate:Representation" name="Autorización de acceso a metadatos" id="id-42760fc73ae347a49173a5274b8d98ef">
      <documentation>Constancia de quién autorizó, y cuándo, el acceso de solo lectura a la estructura de una fuente. Sin ella no se habilita la importación. No es la autorización que firma un titular ni un permiso de acceso a la herramienta.</documentation>
      <property key="Ejemplo" value="Para S1 autoriza la jefa de administración y ejecuta el coordinador de TI (Bloque 8)" />
      <property key="Objeto de negocio en la V5" value="Autorización de acceso a metadatos" />
    </element>
    <element xsi:type="archimate:Representation" name="Atributo de negocio" id="id-8c7c052fed3149299b766c80529b68bc">
      <documentation>Concepto de dato que se documenta una sola vez, con su definición, su responsable y su clasificación, aunque esté guardado en varias columnas de varios sistemas. No es la columna o campo de un sistema fuente, que es solo la ubicación técnica del dato (ver metadato técnico).</documentation>
      <property key="Ejemplo" value="La cédula está en S1, que acepta de 7 a 11 caracteres, y en S2, que acepta letras (Bloque 4): son dos columnas de un mismo atributo" />
      <property key="Objeto de negocio en la V5" value="Atributo de negocio" />
    </element>
    <element xsi:type="archimate:Representation" name="Metadato de negocio" id="id-a3d0a3e2edb74bfbbd060c0047b90e64">
      <documentation>Descripción de un atributo hecha desde el negocio: su definición, su responsable, su política de calidad y su expresión regular. La asignación del responsable, su historial y quién lo designa se gestionan aparte (ver responsable de dato).</documentation>
      <property key="Ejemplo" value="La columna VR_CAN de S1 tiene tres definiciones en uso y ningún responsable asignado (Bloque 5)" />
      <property key="Objeto de negocio en la V5" value="Metadato de negocio" />
    </element>
    <element xsi:type="archimate:Representation" name="Política de calidad" id="id-c84b7da68e344daaadd3c5ed2cef4569">
      <documentation>Regla que describe cómo debe ser el valor de un atributo (formato, longitud, obligatoriedad). Se documenta, no se ejecuta contra los datos.</documentation>
      <property key="Ejemplo" value="La cédula debería tener solo números, de 6 a 10 dígitos y sin puntos (Bloque 4)" />
    </element>
    <element xsi:type="archimate:Representation" name="Expresión regular" id="id-4c1bd93e79ea40f6ae7c3072776bc090">
      <documentation>Patrón de texto que valida el formato de un atributo. Se registra y se comprueba que sea sintácticamente válida, pero no se ejecuta contra datos reales. Valida el formato, no que el dato sea verdadero ni lícito.</documentation>
      <property key="Ejemplo" value="^[0-9]{6,10}$ para la cédula, ilustrativa (Bloque 4)" />
    </element>
    <element xsi:type="archimate:Representation" name="Atributo incompleto" id="id-6c81d5f141e04e7998491a979764de8c">
      <documentation>Atributo al que le falta definición, responsable o clasificación. Se muestra como incompleto y no como correcto.</documentation>
      <property key="Ejemplo" value="Nadie recuerda con certeza qué guarda la columna OBS3 de S1, así que le faltaría la definición (Bloque 5)" />
    </element>
    <element xsi:type="archimate:Representation" name="Clasificación" id="id-ec35156fc7274d599e175ad5b0ccb890">
      <documentation>Asignación a un atributo de una categoría legal, con su criterio y su justificación. No incluye la finalidad del dato.</documentation>
      <property key="Ejemplo" value="La abogada considera privada la cuenta bancaria del propietario (Bloque 4)" />
      <property key="Objeto de negocio en la V5" value="Clasificación del atributo" />
    </element>
    <element xsi:type="archimate:Representation" name="Categoría legal" id="id-e48ddee55d294b38951ff075391128e6">
      <documentation>Cada nivel con que se clasifica un atributo. Las clases pública, semiprivada y privada las define la Ley 1266 de 2008, y la Ley 1581 de 2012 añade otras categorías. El Decreto 1377 de 2013 completa la de dato público: es el que no cae en las otras tres. El dato semiprivado no es íntimo, reservado ni público, y su conocimiento puede interesar a cierto sector o a la sociedad, por ejemplo la información financiera y crediticia de la actividad comercial o de servicios. El privado, por ser íntimo o reservado, solo le interesa a su titular. El sensible es el que afecta la intimidad del titular, y su definición completa está en el art. 5 de la Ley 1581. En el habla cotidiana “delicado” es una intuición; aquí son categorías con definición legal.</documentation>
      <property key="Ejemplo" value="La abogada considera sensible el estado de salud escrito en “observaciones” y dice que no debería estar ahí (Bloque 4)" />
    </element>
    <element xsi:type="archimate:Representation" name="Estado de la clasificación" id="id-0a0e0cbe9ea14e6182ade9cf2ac5e63b">
      <documentation>Punto de revisión de una clasificación: propuesta, en revisión o validada. Es definitiva solo cuando la valida quien tenga la autoridad, hoy Jurídica o el oficial (por definir en R10). Un atributo sin clasificación no tiene estado y se muestra como “sin clasificar”. Ver estado.</documentation>
      <property key="Ejemplo" value="La abogada duda entre privado y semiprivado para el historial de mora (Bloque 4); la clasificación quedaría “en revisión”, con la opinión de cada parte (Bloque 8)" />
    </element>
    <element xsi:type="archimate:Representation" name="Finalidad" id="id-7f02a22cf7484aa3a25b18cc9c592cf5">
      <documentation>Propósito para el cual se usa un dato personal. La herramienta no la registra: es una exclusión explícita, y su cambio no se detecta por software.</documentation>
      <property key="Ejemplo" value="El teléfono del propietario se recogía para la captación, y luego Mercadeo lo compartió con un portal (Bloque 4)" />
    </element>
    <element xsi:type="archimate:Representation" id="id-c1985ef21799431aa81efaf98e77b095">
      <documentation>Atributo al que le falta definición, responsable o clasificación. Se muestra como incompleto y no como correcto.</documentation>
      <property key="Ejemplo" value="Nadie recuerda con certeza qué guarda la columna OBS3 de S1, así que le faltaría la definición (Bloque 5)" />
    </element>
    <element xsi:type="archimate:Representation" name="Responsable de dato" id="id-8d330a436c474bdfbd13e7f687c194e8">
      <documentation>Persona o rol de negocio que responde por la definición y la calidad de un atributo, y queda registrado como tal. Se distingue del administrador técnico (TI, que conoce la estructura pero no decide el significado), del oficial de protección de datos y del Responsable del Tratamiento (término legal).</documentation>
      <property key="Ejemplo" value="Un teléfono errado: TI dice que “es del negocio”, Comercial dice que es de Administración, y nadie lo corrige (Bloque 5)" />
      <property key="Objeto de negocio en la V5" value="Responsabilidad sobre el dato" />
    </element>
    <element xsi:type="archimate:Representation" name="Oficial de protección de datos" id="id-c0124b4eb7b249d6a6b0eb340f629dcf">
      <documentation>Rol por designar, hoy inexistente. La gerencia imagina que mantendría las políticas, atendería los reclamos de los titulares y sería el contacto con la autoridad. Si la ley exige designarlo está por verificar. No es el responsable de dato.</documentation>
      <property key="Ejemplo" value="Ante la solicitud de un titular que pide suprimir sus datos, necesitaría saber en qué sistemas están (Bloque 2)" />
    </element>
    <element xsi:type="archimate:Representation" name="Administrador del diccionario" id="id-0d10e86218fb459eb3d28fa65e601726">
      <documentation>Rol por designar que mantiene el diccionario y el catálogo en la herramienta. No es el administrador técnico de TI ni el “administrador” de permisos.</documentation>
      <property key="Ejemplo" value="TI entrega la estructura técnica a “quien administre el diccionario”, sin que esté definido quién es (Bloque 8)" />
    </element>
    <element xsi:type="archimate:Representation" name="Evidencia de decisión" id="id-fea2d47410414accb02962d1cd34a607">
      <documentation>Registro inmutable de una decisión sobre un atributo (clasificación, definición o responsable): quién, cuándo, con qué criterio y qué cambió. El registro técnico guarda además denegaciones e importaciones, que no son decisiones.</documentation>
      <property key="Ejemplo" value="El negocio querría mostrar quién clasificó un dato, con qué criterio y cuándo (Bloque 7)" />
      <property key="Objeto de negocio en la V5" value="Evidencia de decisión" />
    </element>
    <element xsi:type="archimate:Representation" name="Término de negocio" id="id-72dea91da6ef428b89db91435e2f1a7e">
      <documentation>Palabra con que las áreas nombran un concepto, registrada con su significado y asociada a los atributos que la describen. Puede tener un significado por área.</documentation>
      <property key="Ejemplo" value="“Activo” es un interesado con seguimiento abierto para Comercial y un contrato vigente para Administración (Bloque 2)" />
      <property key="Objeto de negocio en la V5" value="Término de negocio" />
    </element>
    <element xsi:type="archimate:Representation" name="Catálogo de términos" id="id-8985ae9c7d9041a0bac32c260a40abf4">
      <documentation>Conjunto de términos de negocio con sus significados y los atributos asociados. Se consulta junto al diccionario de datos, que puede buscar un atributo por término.</documentation>
      <property key="Ejemplo" value="Quien busque el atributo asociado a “canon” encontraría las dos columnas que lo guardan (Bloques 2 y 5)" />
    </element>
    <element xsi:type="archimate:Representation" name="Conflicto de significado" id="id-72904a022c1d474d8cca195c439b1732">
      <documentation>Un término con más de un significado. Hay dos casos: (a) significados distintos por área, que se mantienen, uno por contexto; (b) disputa dentro de un mismo contexto sobre la definición de un atributo, que la organización debe decidir.</documentation>
      <property key="Ejemplo" value="(a) “Canon” es el valor pactado al firmar para Comercial y el cobrado hoy para Administración (Bloque 2). (b) Tres definiciones de VR_CAN (Bloque 5)" />
    </element>
    <element xsi:type="archimate:Representation" name="Diccionario de datos" id="id-bad5a7c634f34ebd8e9340cb211af6b3">
      <documentation>Vista de solo lectura de cada atributo con su metadato técnico, su metadato de negocio, su clasificación y su responsable, más los términos asociados. Se publica por versiones y marca lo incompleto y la antigüedad de la información técnica.</documentation>
      <property key="Ejemplo" value="La ficha de VR_CAN reuniría su estructura en S1, sus tres definiciones y la ausencia de responsable (Bloque 5)" />
      <property key="Objeto de negocio en la V5" value="Diccionario de datos" />
    </element>
    <element xsi:type="archimate:Representation" name="Informe regulatorio" id="id-35c872b54a2746469d1adb12469bf750">
      <documentation>Informe con información sobre las bases de datos y su clasificación, para que Jurídica lo presente a la autoridad. La herramienta no lo transmite y su formato está por verificar. Si no está validado, no se presenta como definitivo.</documentation>
      <property key="Ejemplo" value="Habría que reunir la lista de bases con datos personales, su finalidad, responsable y encargado, clasificación y medidas de seguridad (Bloque 8)" />
      <property key="Objeto de negocio en la V5" value="Informe regulatorio" />
    </element>
    <element xsi:type="archimate:Representation" name="Permiso de acceso" id="id-fc414fc3604d4829bb976ee9aa348f4f">
      <documentation>Autorización para que un rol realice una operación en la herramienta, como consultar, proponer o aprobar. No es la autorización de acceso a metadatos ni la de un titular.</documentation>
      <property key="Ejemplo" value="Quién puede ver y modificar la clasificación y las definiciones es un punto a revisar antes de dar el diseño por suficiente (Bloque 7)" />
      <property key="Objeto de negocio en la V5" value="Permiso de acceso" />
    </element>
    <element xsi:type="archimate:Representation" name="Rol" id="id-b46932f55546419ba725860e830f6950">
      <documentation>En la herramienta, conjunto de permisos que se asigna a un usuario. En el negocio y en las vistas de ArchiMate, función que alguien cumple (responsable de dato de área, oficial), que no es un cargo.</documentation>
      <property key="Ejemplo" value="Quién propone una definición y quién la aprueba tendrían roles distintos, y esa autoridad sigue por definir (R10, Bloque 3)" />
    </element>
    <element xsi:type="archimate:Representation" name="Cliente" id="id-c77f7721bb6845b48222763b7022f4bb">
      <documentation>Para Comercial es el interesado que busca inmueble; para Administración, el arrendatario; para Contabilidad, el propietario que paga la administración.</documentation>
      <property key="Ejemplo" value="Ilustrativo: una consulta de “clientes” daría interesados si la hace Comercial y propietarios si la hace Contabilidad. La entrevista solo da los significados (Bloque 2)" />
    </element>
    <element xsi:type="archimate:Representation" name="Propietario" id="id-8458ddfcfce74ceb98043e623f982fc0">
      <documentation>Para Comercial es quien firmó el contrato de corretaje; para Administración y Contabilidad, el titular de la cuenta bancaria a la que se paga, que a veces es otra persona.</documentation>
      <property key="Ejemplo" value="Quien firmó el contrato de corretaje puede no ser a quien se le paga (Bloque 2)" />
    </element>
    <element xsi:type="archimate:Representation" name="Interesado" id="id-825a96f7fbbe439f9efc3f018b92e968">
      <documentation>Persona que busca un inmueble y queda registrada con un asesor. No es el interesado (stakeholder) de ArchiMate en la V1.</documentation>
      <property key="Ejemplo" value="Hay interesados de 2016 que nunca contrataron y siguen en S2 (Bloque 1)" />
    </element>
    <element xsi:type="archimate:Representation" name="Inmueble" id="id-50bc687fa96b45079c4215927dc34af7">
      <documentation>Bien que se vende o se arrienda. S1 registra los administrados y S2 los que están en oferta. Que sean el mismo bien en dos momentos es inferencia del equipo, no está en la entrevista.</documentation>
      <property key="Ejemplo" value="S2 publica la ficha del inmueble en el sitio web S4 (Bloque 1)" />
    </element>
    <element xsi:type="archimate:Representation" name="Estado" id="id-70ff35ccc6de45edbc02e656d74382de">
      <documentation>Palabra con varios sentidos: para Comercial, el inmueble está publicado, reservado, vendido o arrendado; para Administración, ocupado, desocupado o en reparación; en S1, el campo describe el contrato (6 valores técnicos); en la herramienta hay un estado de la clasificación y un estado de importación (disponible o desactualizada).</documentation>
      <property key="Ejemplo" value="“Estado” significa “publicado o no” en S2 y “contrato vigente” en S1 (Bloque 1)" />
    </element>
    <element xsi:type="archimate:Representation" name="Activo" id="id-1a700ac2aa0c4b7db444afe41507cb40">
      <documentation>Para Comercial es un interesado con seguimiento abierto; para Administración, un contrato vigente.</documentation>
      <property key="Ejemplo" value="El reporte de morosidad de septiembre incluyó contratos terminados porque “estado = activo” significa cosas distintas en S1 y S2 (Bloque 2)" />
    </element>
    <element xsi:type="archimate:Representation" name="Canon" id="id-540b6dab89ce40a6a28eca41e211a7aa">
      <documentation>Para Comercial es el valor pactado al firmar; para Administración, el valor que se cobra hoy, ya reajustado.</documentation>
      <property key="Ejemplo" value="Tras el reajuste anual (Bloque 1), el valor pactado y el cobrado dejan de coincidir" />
    </element>
    <element xsi:type="archimate:Representation" name="Titular" id="id-4bf6813bd8c1474181ed5d36d908b428">
      <documentation>Persona natural a quien pertenecen los datos personales que se tratan (Ley 1581 de 2012, art. 3). Puede ser propietario, arrendatario, interesado u otra. No es el “titular de la cuenta bancaria” del propietario.</documentation>
      <property key="Ejemplo" value="Un propietario pide que borren sus datos y nadie sabe en cuántos lugares están (Bloque 1)" />
    </element>
    <element xsi:type="archimate:Representation" name="Dato personal" id="id-b62d20668d8f4aa1adacca9003b40489">
      <documentation>Cualquier información que se relacione con una persona natural identificada o que pueda llegar a identificarse (Ley 1581 de 2012, art. 3). La herramienta no lee datos personales, solo la estructura de dónde están (restricción C1).</documentation>
      <property key="Ejemplo" value="La gerente y la abogada no quieren abrir otro punto de exposición de cédulas e ingresos (Bloque 8)" />
    </element>
    <element xsi:type="archimate:Representation" name="Responsable y Encargado del Tratamiento" id="id-5f3af01204004ebb9570c8ac7adadbd3">
      <documentation>Términos legales de la Ley 1581 (art. 3). El Responsable es quien decide, solo o con otros, sobre la base de datos o el tratamiento. El Encargado es la persona natural o jurídica, pública o privada, que realiza el tratamiento por cuenta del Responsable. No es el responsable de dato.</documentation>
      <property key="Ejemplo" value="El proveedor del CRM guarda datos de la empresa y tiene acceso a ellos, sin documento que defina sus responsabilidades (Bloques 3 y 7)" />
    </element>
    <element xsi:type="archimate:BusinessObject" id="id-1184c917425b4e799a5b5bf8a30fe208">
      <documentation>Representa un sistema o lugar donde existen datos cuya estructura técnica debe registrarse y documentarse.
</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" id="id-dee55f68fc30461ba3131b44287069e4" />
    <element xsi:type="archimate:BusinessObject" id="id-129ede6596e340e28737947fc9156ad9">
      <documentation>Representa información técnica de un atributo, como su nombre, tipo de dato o longitud, obtenida de la estructura de una fuente.
</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" id="id-3ce8aaae8ea64a93afa4c55265944a6f">
      <documentation>Representa una diferencia detectada entre versiones de la estructura técnica de una fuente.
</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" id="id-7ef75ccdd65e44d3a3994233e2aca031" />
    <element xsi:type="archimate:BusinessObject" id="id-26d7fac4826d4582aa7f812139c2cfc2" />
    <element xsi:type="archimate:BusinessObject" id="id-5d9f269d6f5e4510901fadd3fc3732a4" />
    <element xsi:type="archimate:BusinessObject" id="id-42e90d80bee44b648af6b89f62e68da6" />
    <element xsi:type="archimate:BusinessObject" id="id-3470639d27c84bf5ae13b16d3ed805ed" />
    <element xsi:type="archimate:BusinessObject" id="id-db45871cafd442cebb7ca0d3c195798b" />
    <element xsi:type="archimate:BusinessObject" id="id-ce3d44c68a8a46c68d43f39126909cbf" />
    <element xsi:type="archimate:BusinessObject" id="id-967add9ece5f402cbbb2c8182d20af44" />
    <element xsi:type="archimate:BusinessObject" id="id-602c6690198d4369a1267e6e8112b32c">
      <documentation>Este objeto representa a la persona o rol que el modelo identifique como responsable. El equipo debe definir qué información concreta se almacenará para identificarlo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" id="id-56db7ed759064bd8a2472c4479f5259f" />
    <element xsi:type="archimate:BusinessObject" id="id-c007150598e54324890fc52d4f2b2749" />
    <element xsi:type="archimate:BusinessObject" name="Atributo de negocio" id="id-310f4d3010ce43e1b6ffaa713bffc89e" />
    <element xsi:type="archimate:BusinessObject" id="id-a1235d72471f47c499ff6f182288fff4" />
    <element xsi:type="archimate:BusinessObject" name="Ficha integrada del atributo" id="id-3fccd1c9c51f4c46852dcd34bade419a" />
    <element xsi:type="archimate:BusinessObject" name="Metadato de negocio" id="id-123aa1ebede44f778914119368c184c1" />
    <element xsi:type="archimate:BusinessObject" name="Metadato Técnico" id="id-b5bee1a831474862947512b0ecb17044">
      <documentation>Representa información técnica de un atributo, como su nombre, tipo de dato o longitud, obtenida de la estructura de una fuente.
</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Clasificación del atributo (RAÍZ)" id="id-35dadf1cf3ef4cd88a4c831f1172643e" />
    <element xsi:type="archimate:BusinessObject" name="Responsabilidad sobre el dato (RAÍZ)" id="id-718891a9794b4e8bbd972812b2623ced" />
    <element xsi:type="archimate:BusinessObject" id="id-ac69e659c9f948ef8319d26a98cfb2bd" />
    <element xsi:type="archimate:BusinessObject" name="Diccionario de datos integrado" id="id-dbb8385d1961446fba26ac3bc3018af9" />
    <element xsi:type="archimate:BusinessObject" name="Rol" id="id-f8e0004781c14f3ba56b198192eac3d4" />
    <element xsi:type="archimate:BusinessObject" id="id-2fd7abd4516246168eda5442cf8f7cb3" />
    <element xsi:type="archimate:BusinessProcess" name="Gobierno E2E del dato personal (de la fuente al reporte)" id="id-48bef983efdc486e9a789b1fcc219109" />
    <element xsi:type="archimate:BusinessProcess" name="Identificar fuentes y gestionar acceso a sus metadatos" id="id-59867cb694514c188df265ef1aa3887b" />
    <element xsi:type="archimate:BusinessProcess" name="Importar metadatos técnicos" id="id-ca3c4a8262b0434fbb663aca2e15cd45" />
    <element xsi:type="archimate:BusinessProcess" name="Inventariar atributos de negocio" id="id-990ca79a820b45aa9afc6fce4b17350a" />
    <element xsi:type="archimate:BusinessProcess" name="Describir atributos (definición, responsable, calidad y validación)" id="id-c53a4b8c27f84903b5827ec96d5e6d00" />
    <element xsi:type="archimate:BusinessProcess" name="Clasificar atributos por categoría legal" id="id-975ee974064c4c4c82167b1245e48f38" />
    <element xsi:type="archimate:BusinessProcess" name="Validar jurídicamente la clasificación" id="id-68c45b8f4c174810b98d4da9f8a24b5f" />
    <element xsi:type="archimate:BusinessProcess" name="Publicar diccionario de datos y catálogo de términos" id="id-ffb913eb58be46139ac335f4579d401e" />
    <element xsi:type="archimate:BusinessProcess" name="Controlar cambios de estructura" id="id-c5d4e183add146f18070b4ecb947a9b3" />
    <element xsi:type="archimate:BusinessProcess" name="Consultar y reportar (titulares, seguridad, SIC)" id="id-874408d016e74e4b9c62cebf8a795fcb" />
  <element xsi:type="archimate:BusinessRole" name="Administrador del diccionario de datos (por designar)" id="id-41ed665b1e67410cbbecf25360f07331">
      <documentation>Rol por designar. Administra atributos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Responsable de dato de área (por designar)" id="id-db5effa4768d42db92557e18cacd5b74">
      <documentation>Rol por designar. Administra metadatos de negocio.</documentation>
    </element>
    <element xsi:type="archimate:Representation" name="Atributo de negocio" id="id-b737ea4107a24e41b2e2b667f0a0fb07">
      <documentation>Concepto de dato que se documenta una sola vez, con su definición, su responsable y su clasificación, aunque esté guardado en varias columnas de varios sistemas. No es la columna o campo del sistema fuente, que es solo la ubicación técnica del dato.</documentation>
      <property key="Contexto" value="C2" />
    </element>
    <element xsi:type="archimate:Representation" name="Metadato de negocio" id="id-8c118c9506db4a67a30e56034874e5b6">
      <documentation>Descripción de un atributo hecha desde el negocio: definición, responsable, política de calidad y expresión regular. La asignación del responsable, su historial y quién lo designa se gestionan aparte (C4).</documentation>
      <property key="Contexto" value="C2" />
    </element>
    <element xsi:type="archimate:Representation" name="Política de calidad" id="id-d2e2fc6e8dc64119a82628b5d7fa3a7e">
      <documentation>Regla que describe cómo debe ser el valor de un atributo (formato, longitud, obligatoriedad). Se documenta, no se ejecuta contra los datos.</documentation>
      <property key="Contexto" value="C2" />
    </element>
    <element xsi:type="archimate:Representation" name="Expresión regular" id="id-c434cc9ea782459ca3a73932408ee1f0">
      <documentation>Patrón que valida el formato de un atributo. Se registra y se comprueba que su sintaxis sea válida, pero no se ejecuta contra datos reales. No garantiza que el dato sea verdadero ni lícito.</documentation>
      <property key="Contexto" value="C2" />
    </element>
    <element xsi:type="archimate:Representation" name="Atributo incompleto" id="id-adda3a5f6db9414aac8188550db55bf3">
      <documentation>Atributo al que le falta definición, responsable o clasificación. Se muestra como incompleto y no como correcto (lo calcula C6).</documentation>
      <property key="Contexto" value="C2" />
    </element>
    <element xsi:type="archimate:Representation" name="Fuente de datos" id="id-829d05f2e0d14b399ffc6db88ee0a867">
      <documentation>Solo como referencia a C1.</documentation>
      <property key="Contexto" value="C1 (referencia)" />
    </element>
    <element xsi:type="archimate:Representation" name="Responsable de dato" id="id-177a4b2b936340589527615435999528">
      <documentation>Solo como referencia a C4.</documentation>
      <property key="Contexto" value="C4 (referencia)" />
    </element>
    <element xsi:type="archimate:BusinessObject" name="Atributo de negocio" id="id-9b15b067fffe4b199abbac25fa79cb31">
      <documentation>Objeto de negocio del subdominio 2 (V5).</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Metadato de negocio" id="id-a2ec774ff55b4351b2f3d608abf11284">
      <documentation>Objeto de negocio del subdominio 2 (V5).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Atributo de negocio registrado" id="id-088be4aef2844554a9652fdde5e8f41d">
      <documentation>Evento de C2 (V6.b). Lo consume C6.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Metadato de negocio actualizado" id="id-ebe74247d071478d999c94f63dc45795">
      <documentation>Evento de C2 (V6.b). Lo consumen C4 (evidencia de la decisión) y C6.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Política de calidad registrada" id="id-2dcbcc5227884732983f8a4b8d08c412">
      <documentation>Evento de C2 (V6.b). Sin consumidor asignado (P).</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Expresión regular validada" id="id-db84481cff554ae491e00f25edf27904">
      <documentation>Evento de C2 (V6.b). Sin consumidor asignado (P).</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-b6401876d1e042f8b6ef0359d8bd1ab6" type="application">
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Autorizar acceso a metadatos" id="id-7c1ecf5c0ec540e985c4fb7f6af15666" />
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Importar metadatos técnicos" id="id-8ffa48a7cdb847abbd9bf450970274c2" />
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Comparar estructuras" id="id-7ac1a95792f949058ab0c9eeb722182b" />
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Revocar autorización de metadatos" id="id-ae1d8e0389cd4f5eb0cfad70138050e6" />
