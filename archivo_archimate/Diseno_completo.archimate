    <element xsi:type="archimate:DataObject" name="Autorización de acceso a metadatos" id="id-087ef7ef859c4a219605f31221689aa8">
      <documentation>Registro asociado a una fuente específica que permite identificar la autorización para consultar sus metadatos, el autorizador correspondiente y la constancia del acceso autorizado.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Metadato Técnico" id="id-ea15568e30454bb08e6a9866a1007528">
      <documentation>Representa información técnica, como el nombre de una columna, su tipo o longitud, según lo que entregue la fuente.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Versión de estructura" id="id-36defd98167e4f0d841a2f987bcf08f7">
      <documentation>Representa la estructura técnica de una fuente en un momento de importación determinado.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Cambio de estructura" id="id-133f049a5eca48708a11b9ffedbe2b14" />
