  <folder name="Technology &amp; Physical" id="id-6e69eae72d9347b3a95ff4ab0d247113" type="technology" />
  <folder name="Motivation" id="id-44e90997779f45f7be02a66fab251e38" type="motivation">
    <element xsi:type="archimate:Meaning" name="Comercial: interesado que busca inmueble&#09;" id="id-11776a378e3f4da88b8f4a793b5d2098">
      <documentation>Para Comercial, el cliente es el interesado que busca inmueble.</documentation>
      <property key="Contexto" value="Comercial" />
    </element>
    <element xsi:type="archimate:Meaning" name="Comercial: interesado que busca inmueble&#09; (copy)" id="id-fc6a0fbaff8945d187f9141664bb4b2c">
      <documentation>Para Comercial, el cliente es el interesado que busca inmueble.</documentation>
      <property key="Contexto" />
    </element>
    <element xsi:type="archimate:Meaning" name="Comercial: interesado que busca inmueble&#09; (copy)" id="id-cfcc16b52cb048f5abe9f6a52fe49eb4">
      <documentation>Para Comercial, el cliente es el interesado que busca inmueble.</documentation>
      <property key="Contexto" />
    </element>
    <element xsi:type="archimate:Meaning" name="Administración: arrendatario" id="id-6bb6f14b68564ba6af9149115cf4dd80">
      <documentation>Para Comercial, el cliente es el interesado que busca inmueble.</documentation>
      <property key="Contexto" value="Administración" />
    </element>
    <element xsi:type="archimate:Meaning" name="Contabilidad: propietario que paga la administración" id="id-8548759d9ac74946861907e1ce8ac74f">
      <documentation>Para Comercial, el cliente es el interesado que busca inmueble.</documentation>
      <property key="Contexto" value="Contabilidad" />
    </element>
    <element xsi:type="archimate:Meaning" name="Administración y Contabilidad: titular de la cuenta a la que se paga" id="id-02b2684dbf3445ef838a2ead530dc700">
      <documentation>Es el titular de la cuenta bancaria a la que se paga, que a veces es otra persona.</documentation>
      <property key="Contexto" value="Administración y Contabilidad" />
    </element>
    <element xsi:type="archimate:Meaning" name="Comercial: quien firmó el contrato de corretaje" id="id-cc785800afd44f0d9022014c3d678568">
      <documentation>Para Comercial, es quien firmó el contrato de corretaje.</documentation>
      <property key="Contexto" value="Comercial" />
    </element>
    <element xsi:type="archimate:Meaning" name="Administración: ocupado, desocupado o en reparación" id="id-53c8a41a04014c159a57c91afdf57442">
      <documentation>Para Administración, el estado del inmueble es ocupado, desocupado o en reparación.</documentation>
      <property key="Contexto" value="Administración" />
    </element>
    <element xsi:type="archimate:Meaning" name="Sistema S1: describe el contrato" id="id-5cb59df442dd4b8c980272542058b346">
      <documentation>En S1, el campo ESTADO describe el contrato y admite 6 valores técnicos.</documentation>
      <property key="Contexto" value="Sistema S1" />
    </element>
    <element xsi:type="archimate:Meaning" name="Herramienta: estado de la clasificación" id="id-d9f525219a4f4497a4d4cd7666098d21">
      <documentation>Propuesta, en revisión o validada.</documentation>
      <property key="Contexto" value="Herramienta" />
    </element>
    <element xsi:type="archimate:Meaning" name="Herramienta: estado de importación" id="id-3aba23b25155496e869d3178f3a7ff9c">
      <documentation>Disponible o desactualizada.</documentation>
      <property key="Contexto" value="Herramienta" />
    </element>
    <element xsi:type="archimate:Meaning" name="Comercial: publicado, reservado, vendido o arrendado" id="id-b254b170c47e4508a9db45630be7e600">
      <documentation>Para Comercial, el estado del inmueble es publicado, reservado, vendido o arrendado.</documentation>
      <property key="Contexto" value="Comercial" />
    </element>
    <element xsi:type="archimate:Meaning" name="Administración: contrato vigente" id="id-ca6d94224f034e0f8975487b1aa027d6">
      <documentation>Para Administración, activo es un contrato vigente.</documentation>
      <property key="Contexto" value="Administración" />
    </element>
    <element xsi:type="archimate:Meaning" name="Comercial: interesado con seguimiento abierto" id="id-2d766bf455c34102bc2d76bd797da588">
      <documentation>Para Comercial, activo es un interesado con seguimiento abierto.</documentation>
      <property key="Contexto" value="Comercial" />
    </element>
    <element xsi:type="archimate:Meaning" name="Administración: valor que se cobra hoy" id="id-87b44d1df85c4b4d8e407d2cd7bbd568">
      <documentation>Para Administración, el canon es el valor que se cobra hoy, ya reajustado.</documentation>
      <property key="Contexto" value="Administración" />
    </element>
    <element xsi:type="archimate:Meaning" name="Comercial: valor pactado al firmar" id="id-555a778703cb48a487f20995acf4dd95">
      <documentation>Para Comercial, el canon es el valor pactado al firmar.</documentation>
      <property key="Contexto" value="Comercial" />
    </element>
    <element xsi:type="archimate:Meaning" name="Negocio y ArchiMate: función que alguien cumple" id="id-8e1bddbf40984b4aae56030fd399b245">
      <documentation>Función que alguien cumple, como responsable de dato de área u oficial. No es un cargo.</documentation>
      <property key="Contexto" value="Negocio y ArchiMate" />
    </element>
    <element xsi:type="archimate:Meaning" name="Herramienta: conjunto de permisos" id="id-eaaeb66a237f40f6a1afe98ad496d7d1">
      <documentation>Conjunto de permisos que se asigna a un usuario.</documentation>
      <property key="Contexto" value="Herramienta" />
    </element>
    <element xsi:type="archimate:Meaning" name="TI: administrador técnico" id="id-eb836e1f645246bdb7aef6afc6845227">
      <documentation>Conoce la estructura de la base de datos, pero no decide el significado de los datos.</documentation>
      <property key="Contexto" value="TI" />
    </element>
    <element xsi:type="archimate:Meaning" name="Negocio: responde por la definición y la calidad" id="id-2f407eae35d840dd826099fe123c65d3">
      <documentation>Persona o rol de negocio que responde por la definición y la calidad de un atributo.</documentation>
      <property key="Contexto" value="Negocio" />
    </element>
    <element xsi:type="archimate:Meaning" name="Legal: Responsable del Tratamiento" id="id-025b127f2d3c426abdf31ac57c276ca4">
      <documentation>Quien decide, solo o con otros, sobre la base de datos o el tratamiento (Ley 1581, art. 3).</documentation>
      <property key="Contexto" value="Legal" />
    </element>
    <element xsi:type="archimate:Meaning" name="ArchiMate: stakeholder" id="id-09647de1bfda4229a91662c893957751">
      <documentation>Persona, equipo u organización con interés en la solución. Es el elemento Stakeholder de la V1.</documentation>
      <property key="Contexto" value="ArchiMate (V1)" />
    </element>
    <element xsi:type="archimate:Meaning" name="Comercial: persona que busca un inmueble" id="id-6a2aaf1f7f364f64a4b9f84e9d91fef4">
      <documentation>Persona que busca un inmueble y queda registrada con un asesor.</documentation>
      <property key="Contexto" value="Comercial" />
    </element>
    <element xsi:type="archimate:Meaning" name="Administración y Contabilidad: titular de la cuenta" id="id-6ef6a5a716534311a7cb3631f753c358">
      <documentation>Titular de la cuenta bancaria a la que se paga al propietario.</documentation>
      <property key="Contexto" value="Administración y Contabilidad" />
    </element>
    <element xsi:type="archimate:Meaning" name="Legal: persona natural dueña de los datos" id="id-09e994db7c17400bb2cc5bb37cf521ad">
      <documentation>Persona natural a quien pertenecen los datos personales que se tratan (Ley 1581, art. 3).</documentation>
      <property key="Contexto" value="Legal" />
    </element>
    <element xsi:type="archimate:Meaning" name="Sistema fuente: columna o campo" id="id-a561e4bac0c146ad85913da0abf963d6">
      <documentation>Ubicación técnica del dato dentro de un sistema.</documentation>
      <property key="Contexto" value="Sistema fuente" />
    </element>
    <element xsi:type="archimate:Meaning" name="Herramienta: concepto de dato documentado una sola vez" id="id-492067fb940548279990c33b8c20d914">
      <documentation>Concepto de dato guardado en varias columnas de varios sistemas.</documentation>
      <property key="Contexto" value="Herramienta" />
    </element>
    <element xsi:type="archimate:Goal" name="Gobernar los datos y apoyar el cumplimiento de protección de datos" id="id-ff8a8f0eb97542fc9c2e8af72da73cda">
      <documentation>Meta general (V1). Se compone de G2 a G6.</documentation>
    </element>
