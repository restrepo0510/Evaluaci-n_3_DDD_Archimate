    <element xsi:type="archimate:ApplicationEvent" name="Evento: Permiso asignado a rol" id="id-8df1372ace63439d946acf221dd0db8d" />
    <element xsi:type="archimate:ApplicationEvent" name="Evento: Permiso revocado de rol" id="id-e7c5e513275649278c15d605246621b8" />
    <element xsi:type="archimate:ApplicationEvent" name="Evento: Operación autorizada" id="id-7c89597b7b8e461c9511b3ddb62e69a8">
      <documentation>solo debe producirse si la autorización tiene éxito.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Rol" id="id-66882be4ca364879bb934993a6e2641a" />
    <element xsi:type="archimate:DataObject" name="Permiso de acceso" id="id-19bfc2cb87a94b8cb00c0929e45a8bf4" />
    <element xsi:type="archimate:DataObject" name="Asignación de permiso a rol" id="id-92b2ce5b9864422bb8cd3b69f15eb79f" />
    <element xsi:type="archimate:ApplicationComponent" name="C1" id="id-5516a609c1654b0fae438af0e0d7cf68" />
    <element xsi:type="archimate:ApplicationComponent" name="C1 · Fuentes y metadatos técnicos" id="id-71ac19742d9e4a2888ae9a530cb28723">
      <documentation>Conoce y mantiene la estructura técnica de las fuentes y detecta sus cambios, sin leer datos de personas</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="C2 · Atributos de negocio" id="id-77db44d5933a46a197038057a1a19b9e">
      <documentation>Registra y describe cada atributo de negocio una sola vez, con su definición y reglas de calidad</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="C3 · Clasificación y validación jurídica" id="id-5720dbc5688a4438a953b320625382fa">
      <documentation>Clasifica los atributos por categoría legal y registra la validación de Jurídica</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="C4 · Responsables, autoridad y decisiones" id="id-e41c620e3886406b8ce1c6151537564a">
      <documentation>Registra quién responde por cada atributo y conserva la evidencia de las decisiones</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="C5 · Catálogo de términos" id="id-ea04bba80ff541b886b34ec8d229fcff">
      <documentation>Mantiene los términos de negocio con sus significados por área y los asocia a atributos</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="C6 · Diccionario y reporte" id="id-ec8cfc9191d84fee8ebc8a359b539359">
      <documentation>Muestra la información integrada en fichas, versiones publicadas e informes, sin ser dueño de lo que muestra</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="C7 · Control de acceso por rol" id="id-41d0697b5de14c5ea33ee3fd6ed41e32">
      <documentation>Controla qué rol puede realizar cada operación en la herramienta</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de control de acceso" id="id-2257c5a7384047198828534761cbd787">
      <documentation>Verifica el permiso de cada rol antes de cada operación y registra las denegaciones. Basado en el contrato 4.12.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de fuentes y autorizaciones" id="id-5673267d6c9b487f86c157471b3313a1">
      <documentation>Registra cada fuente con su autorizador y la constancia del acceso de solo lectura. Basado en los contratos 3.1 y 4.3.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de importación de estructura" id="id-26d1e03e163d4611a68e80e75903e97a">
      <documentation>Trae la estructura técnica de S1 a S4 por los adaptadores A1 y A2; nunca registros. Basado en los contratos 3.2 y 4.2.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de inventario de atributos" id="id-4e304642ccab440f890613be495a4e83">
      <documentation>Consolida columnas equivalentes en un atributo y carga el inventario manual de fuentes sin motor (A4). Basado en los contratos 3.3 y 4.1.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de descripción de atributos" id="id-327c4b9bb3ba45d0a4c2e0561c5249ff">
      <documentation>Registra definición, política de calidad y expresión regular (validada solo en sintaxis). Basado en los contratos 3.4 y 4.4.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de responsables y evidencia" id="id-d7a53f66bfac4fa8b06b56458b215109">
      <documentation>Asigna y reasigna responsables con histórico y guarda la evidencia inmutable de cada decisión. Basado en los contratos 3.5, 4.5 y 4.10.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de clasificación" id="id-3af3f2b507d146908b6a9d8683fff7da">
      <documentation>Registra la categoría legal con criterio y justificación; sin justificación no guarda. Basado en los contratos 3.6 y 4.6.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de validación jurídica" id="id-ba29aafc7d8543e48c9c506830053597">
      <documentation>Lleva la clasificación a 'validada' u 'en revisión' con la opinión de cada parte. Basado en el contrato 3.7.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de catálogo de términos" id="id-59b608cbe3e3463ba4f7f8d35ac50793">
      <documentation>Gestiona términos, sus significados por contexto, conflictos y atributos asociados. Basado en los contratos 3.9 y 4.7.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de diccionario integrado" id="id-810f17ec821f4dfab3a2dd02470c7f9f">
      <documentation>Publica por versiones la ficha de cada atributo y marca lo incompleto y la antigüedad técnica. Basado en los contratos 3.8 y 4.8.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de cambios de estructura" id="id-bdd88e55e14849429ae7fa691dccc2ec">
      <documentation>Compara importaciones, registra diferencias y marca de riesgo las que tocan atributos sensibles. Basado en los contratos 3.10 y 4.9.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Servicio de aplicación de consulta y reporte" id="id-d8ca834ad1864954acf797a14232ea87">
      <documentation>Ubica datos personales por atributo, informa a seguridad, mide completitud y exporta el informe para la SIC (A5 a A8). Basado en los contratos 3.11 a 3.14, 4.11 y 4.13.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Componente de control de acceso por rol" id="id-a70e35f7cbf84a52bcc2d777050c3650">
      <documentation>Componente propuesto en la V10, uno por subdominio de la V5. Confirmar en el mapa de contextos (V8).</documentation>
      <property key="Subdominio (V5)" value="8 · Control de acceso por rol (Genérico)" />
      <property key="Estado" value="Propuesto en la V10; confirmar en la V8" />
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Componente de fuentes y metadatos técnicos" id="id-14fdddad3a364898ad9c1041f7bb541e">
      <documentation>Componente propuesto en la V10, uno por subdominio de la V5. Confirmar en el mapa de contextos (V8).</documentation>
      <property key="Subdominio (V5)" value="1 · Fuentes y metadatos técnicos (Soporte)" />
      <property key="Estado" value="Propuesto en la V10; confirmar en la V8" />
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Componente de atributos de negocio" id="id-607470ca093042d59fcea3eb79537c13">
      <documentation>Componente propuesto en la V10, uno por subdominio de la V5. Confirmar en el mapa de contextos (V8).</documentation>
      <property key="Subdominio (V5)" value="2 · Atributos de negocio y su descripción (Core)" />
      <property key="Estado" value="Propuesto en la V10; confirmar en la V8" />
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Componente de responsables y decisiones" id="id-6e961e01762143f89f8067effca21ece">
      <documentation>Componente propuesto en la V10, uno por subdominio de la V5. Confirmar en el mapa de contextos (V8).</documentation>
      <property key="Subdominio (V5)" value="4 · Responsables, autoridad y decisiones (Soporte)" />
      <property key="Estado" value="Propuesto en la V10; confirmar en la V8" />
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Componente de clasificación y validación jurídica" id="id-c1c2c38ae6564f0fb4a7c172e21781e6">
      <documentation>Componente propuesto en la V10, uno por subdominio de la V5. Confirmar en el mapa de contextos (V8).</documentation>
      <property key="Subdominio (V5)" value="3 · Clasificación y validación jurídica (Core)" />
      <property key="Estado" value="Propuesto en la V10; confirmar en la V8" />
    </element>
