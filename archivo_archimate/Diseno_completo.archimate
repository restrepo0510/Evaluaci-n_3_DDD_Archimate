    <element xsi:type="archimate:DataObject" name="Informe regulatorio" id="id-d04c329aa8614f24a7ac8c803f9c7320" />
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Crear rol" id="id-3fb89921e18348b59e36cabc7c7c8a92" />
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Asignar permiso a rol" id="id-1f6be93d63ba441094a4b2ceb568835c" />
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Revocar permiso de rol" id="id-6e055290db144fe18f29f6b0959f4803" />
    <element xsi:type="archimate:ApplicationProcess" name="Comando: Autorizar operación" id="id-96f84dee82b343cc9284dfb5d36f3ac0" />
