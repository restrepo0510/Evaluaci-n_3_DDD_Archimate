    <element xsi:type="archimate:DataObject" name="Metadato de negocio" id="id-6b39d1c3970e4ecdab6373c0aa83d435" />
    <element xsi:type="archimate:DataObject" name="Política de calidad" id="id-7b44b28b605f4dc6aa1aa0fcf0e7870f" />
