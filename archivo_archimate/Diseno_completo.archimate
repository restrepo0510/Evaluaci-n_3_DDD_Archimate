    <element xsi:type="archimate:CourseOfAction" name="Inventariar y clasificar primero los atributos con datos personales" id="id-e-0084">
      <documentation>Propuesta del equipo basada en las metas de ejemplo del Bloque 6 de la entrevista; por validar.</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="Documentar la estructura técnica de S1, S3 y S4 y gestionar S2 vía proveedor" id="id-e-0085">
      <documentation>Propuesta del equipo basada en las metas de ejemplo del Bloque 6 de la entrevista; por validar.</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="Establecer roles de gobierno (oficial, responsables de dato) y registrar decisiones" id="id-e-0086">
      <documentation>Propuesta del equipo basada en las metas de ejemplo del Bloque 6 de la entrevista; por validar.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Valoración y fijación de precios de inmuebles" id="id-e-9001">
      <documentation>Definir el precio de oferta del inmueble a partir del mercado. La entrevista registra el precio al captar, pero no dice quién lo fija ni cómo: capacidad inferida.</documentation>
      <property key="Nivel" value="Nivel 2" />
      <property key="Tipo de capacidad" value="Táctica" />
      <property key="Rol estratégico (empresa)" value="Diferenciadora" />
      <property key="Subdominio DDD (solución Tema 2)" value="N/A (fuera de la solución)" />
      <property key="Impacto de la solución" value="Indirecto" />
      <property key="Madurez actual (según entrevista)" value="No evaluada" />
      <property key="Estado de validación" value="Inferida (validar con experto)" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de entrega de inmuebles y devolución de depósitos" id="id-e-9003">
      <documentation>Cerrar el arriendo con el acta de entrega del inmueble y la devolución de depósitos. Genera acta y saldos (entrevista, etapa Cierre).</documentation>
      <property key="Nivel" value="Nivel 2" />
      <property key="Tipo de capacidad" value="Táctica" />
      <property key="Rol estratégico (empresa)" value="Diferenciadora" />
      <property key="Subdominio DDD (solución Tema 2)" value="N/A (fuera de la solución)" />
      <property key="Impacto de la solución" value="Indirecto" />
      <property key="Madurez actual (según entrevista)" value="No evaluada" />
      <property key="Estado de validación" value="Respaldada por la entrevista" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión tributaria" id="id-e-9005">
      <documentation>Cumplir obligaciones tributarias de la empresa y de las comisiones y recaudos. No cubierta por la entrevista: capacidad inferida.</documentation>
      <property key="Nivel" value="Nivel 2" />
      <property key="Tipo de capacidad" value="Táctica" />
      <property key="Rol estratégico (empresa)" value="Soporte" />
      <property key="Subdominio DDD (solución Tema 2)" value="N/A (fuera de la solución)" />
      <property key="Impacto de la solución" value="Sin impacto" />
      <property key="Madurez actual (según entrevista)" value="No evaluada" />
      <property key="Estado de validación" value="Inferida (validar con experto)" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión Administrativa y de Compras" id="id-e-9007">
      <documentation>Compras y servicios generales de la inmobiliaria (sede y dos sucursales). No cubierta por la entrevista: capacidad inferida.</documentation>
      <property key="Nivel" value="Nivel 1" />
      <property key="Tipo de capacidad" value="Estratégica" />
      <property key="Rol estratégico (empresa)" value="Genérica" />
      <property key="Subdominio DDD (solución Tema 2)" value="N/A (fuera de la solución)" />
      <property key="Impacto de la solución" value="Sin impacto" />
      <property key="Madurez actual (según entrevista)" value="No evaluada" />
      <property key="Estado de validación" value="Inferida (validar con experto)" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de compras y proveedores" id="id-e-9008">
      <documentation>Seleccionar y contratar proveedores generales.</documentation>
      <property key="Nivel" value="Nivel 2" />
      <property key="Tipo de capacidad" value="Táctica" />
      <property key="Rol estratégico (empresa)" value="Genérica" />
      <property key="Subdominio DDD (solución Tema 2)" value="N/A (fuera de la solución)" />
      <property key="Impacto de la solución" value="Sin impacto" />
      <property key="Madurez actual (según entrevista)" value="No evaluada" />
      <property key="Estado de validación" value="Inferida (validar con experto)" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de instalaciones y servicios generales" id="id-e-9010">
      <documentation>Mantener sedes, equipos y servicios generales.</documentation>
      <property key="Nivel" value="Nivel 2" />
      <property key="Tipo de capacidad" value="Táctica" />
      <property key="Rol estratégico (empresa)" value="Genérica" />
      <property key="Subdominio DDD (solución Tema 2)" value="N/A (fuera de la solución)" />
      <property key="Impacto de la solución" value="Sin impacto" />
      <property key="Madurez actual (según entrevista)" value="No evaluada" />
      <property key="Estado de validación" value="Inferida (validar con experto)" />
    </element>
    <element xsi:type="archimate:ValueStream" name="Intermediación inmobiliaria (de la captación al cierre)" id="id-e-9012">
      <documentation>Cadena de valor del negocio. El arriendo recorre las seis etapas; la venta omite 'Administrar la vigencia' y termina en 'Cerrar' con la liquidación de la comisión. Fuente: Bloque 1 de la entrevista.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Captar y publicar" id="id-e-9013">
      <documentation>Captación del propietario con contrato de corretaje, fotos y publicación en web y portales. Capacidades que la habilitan: Captación de propietarios e inmuebles; Gestión de la información del inmueble; Valoración y fijación de precios de inmuebles; Gestión de contenidos de inmuebles; Gestión de canales web y portales.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Atender interesados" id="id-e-9015">
      <documentation>Recepción de interesados por web, portales, teléfono y WhatsApp, y registro en el CRM. Capacidades que la habilitan: Gestión de interesados; Atención de visitas y negociación; Gestión del conocimiento del cliente; Gestión de canales web y portales.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Evaluar y negociar" id="id-e-9017">
      <documentation>Estudio y aprobación del candidato (arriendo) u oferta y negociación con revisión jurídica (venta). Capacidades que la habilitan: Evaluación de candidatos a arrendamiento; Atención de visitas y negociación; Asesoría y revisión legal.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Formalizar" id="id-e-9019">
      <documentation>Firma del contrato de arriendo, o promesa de compraventa y escritura. Capacidades que la habilitan: Gestión de contratos de arrendamiento; Gestión de la venta de inmuebles; Asesoría y revisión legal.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Administrar la vigencia" id="id-e-9021">
      <documentation>Solo arriendo: cobro mensual, pago al propietario, reparaciones, reajuste anual y renovación. Capacidades que la habilitan: Gestión de contratos de arrendamiento; Gestión de recaudo y cartera; Gestión de pagos a propietarios; Gestión de novedades y mantenimiento de inmuebles; Gestión contable y de facturación; Gestión de tesorería; Gestión de cobro jurídico; Atención de peticiones, quejas y reclamos.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Cerrar" id="id-e-9023">
      <documentation>Acta de entrega y devolución de depósitos (arriendo) o liquidación de comisión (venta). Capacidades que la habilitan: Gestión de renovación y cierre de contratos; Gestión de entrega de inmuebles y devolución de depósitos; Gestión de comisiones; Gestión contable y de facturación.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Gobierno de datos personales (del dato desconocido al dato gobernado)" id="id-e-9060">
      <documentation>Cadena de valor del Tema 2. Valor para la gerencia, los titulares y la SIC: saber qué datos hay, qué significan, cuáles son delicados y poder responder por ellos. Gobierna los datos que nacen en la cadena de intermediación.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Conocer los datos" id="id-e-9061">
      <documentation>Saber qué sistemas y atributos existen. Capacidades que la habilitan: Gestión de metadatos técnicos; Inventario de atributos de negocio; Gestión de aplicaciones y proveedores de software; Administración de accesos e identidades.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Describir los datos" id="id-e-9063">
      <documentation>Dar a cada atributo definición, responsable y reglas de calidad. Capacidades que la habilitan: Gestión de metadatos de negocio; Gestión de responsables de datos; Definición de políticas y reglas de calidad y validación.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Clasificar los datos" id="id-e-9065">
      <documentation>Asignar la categoría legal con criterio y validación jurídica. Capacidades que la habilitan: Clasificación de atributos por categoría legal; Validación jurídica de la clasificación; Resolución de conflictos y decisiones sobre datos; Gestión del cumplimiento normativo.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Publicar y mantener el diccionario" id="id-e-9067">
      <documentation>Integrar y publicar el diccionario y el catálogo de términos y mantenerlos al día. Capacidades que la habilitan: Gestión del diccionario de datos; Gestión del catálogo de términos de negocio; Gestión de cambios de estructura de datos; Gestión de trazabilidad y evidencia de decisiones.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Usar y rendir cuentas" id="id-e-9069">
      <documentation>Atender titulares, orientar controles de seguridad y reportar. Capacidades que la habilitan: Atención de derechos de los titulares; Reporte regulatorio ante la SIC; Gestión de la seguridad de la información; Atención de peticiones, quejas y reclamos; Gestión del desempeño e indicadores.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Administración de accesos e identidades" id="id-78947a6843cb44a097c39a1692cad6b8">
      <property key="Impacto de la solución" value="Indirecto" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de metadatos técnicos" id="id-af194ad6ccb7433fad226192cadfffd5">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Inventario de atributos de negocio" id="id-cf3326509cfd45fdb3c800bb94374946">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de metadatos de negocio" id="id-615730e0ee294ad68861eb4ba1eb6c84">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de responsables de datos" id="id-68b67a442ce746cead93bdff9063eac4">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Definición de políticas y reglas de calidad y validación" id="id-5c34984b3d2f4bafa34022b8250f060c">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Clasificación de atributos por categoría legal" id="id-616b87228b0c4daaa612f0dd28ecdc2a">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Validación jurídica de la clasificación" id="id-8ee835e277764dc8b12bd315a12024bc">
      <property key="Impacto de la solución" value="Parcial" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión del catálogo de términos de negocio" id="id-f98d93b35b8147e3bb9d48129922ab93">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión del diccionario de datos" id="id-81490072287446779911333ebb962575">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de cambios de estructura de datos" id="id-e03494b64ddb42d1b1abfc0460c3480f">
      <property key="Impacto de la solución" value="Parcial" />
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de trazabilidad y evidencia de decisiones" id="id-96036a8377e04731b745c76b92061021">
      <property key="Impacto de la solución" value="Directo" />
    </element>
    <element xsi:type="archimate:Capability" name="Reporte regulatorio ante la SIC" id="id-f181ce101fa74f56842084ab251d5628">
      <property key="Impacto de la solución" value="Parcial" />
    </element>
  </folder>
  <folder name="Business" id="id-ed93b8c4692d41e0b641127030df254f" type="business">
    <element xsi:type="archimate:BusinessProcess" name="Gobierno E2E del dato personal (de la fuente al reporte)" id="id-e-9096">
      <documentation>Proceso extremo a extremo en el que opera la solución del Tema 2. Propuesta del equipo basada en el alcance del enunciado y en el Bloque 2 de la entrevista; el diseño detallado corresponde a las vistas de procesos.</documentation>
      <property key="Apoyo de la solución" value="Sí (transversal)" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Identificar fuentes y gestionar acceso a sus metadatos" id="id-e-9097">
      <documentation>TI y proveedores habilitan acceso de solo lectura a S1, S3, S4 y (vía proveedor) S2.</documentation>
      <property key="Apoyo de la solución" value="No" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Importar metadatos técnicos" id="id-e-9102">
      <documentation>Traer tipo de dato y longitud desde los diccionarios de los motores.</documentation>
      <property key="Apoyo de la solución" value="Sí" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Inventariar atributos de negocio" id="id-e-9106">
      <documentation>Consolidar los atributos distintos y sumar los de fuentes sin motor (hojas, carpetas).</documentation>
      <property key="Apoyo de la solución" value="Sí" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Describir atributos (definición, responsable, calidad y validación)" id="id-e-9110">
      <documentation>Registrar metadatos de negocio por atributo.</documentation>
      <property key="Apoyo de la solución" value="Sí" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Clasificar atributos por categoría legal" id="id-e-9116">
      <documentation>Asignar categoría con criterio y justificación.</documentation>
      <property key="Apoyo de la solución" value="Sí" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Validar jurídicamente la clasificación" id="id-e-9120">
      <documentation>Jurídica revisa y deja constancia; la herramienta registra.</documentation>
      <property key="Apoyo de la solución" value="Parcial" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Publicar diccionario de datos y catálogo de términos" id="id-e-9125">
      <documentation>Integrar lo técnico y lo de negocio y asociar términos a atributos.</documentation>
      <property key="Apoyo de la solución" value="Sí" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Controlar cambios de estructura" id="id-e-9130">
      <documentation>Detectar cambios entre importaciones y dejar evidencia.</documentation>
      <property key="Apoyo de la solución" value="Parcial" />
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Consultar y reportar (titulares, seguridad, SIC)" id="id-e-9135">
      <documentation>Ubicar datos de una persona, informar atributos sensibles y preparar el reporte.</documentation>
      <property key="Apoyo de la solución" value="Parcial" />
    </element>
    <element xsi:type="archimate:BusinessActor" name="Gerente general" id="id-e-9150">
      <documentation>Aprueba las políticas y asigna recursos. Hoy nunca ha aprobado una política sobre datos (entrevista, Bloque 3).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Director comercial" id="id-e-9151">
      <documentation>Conoce los datos de captación e interesados y responde por lo que digitan los asesores en S2.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Jefa de administración de arrendamientos" id="id-e-9152">
      <documentation>Responde por S1 y por la exactitud de contratos y cánones; conoce el significado de esos datos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Abogada interna" id="id-e-9153">
      <documentation>Revisa contratos y documentos. Sin nombramiento formal, atiende hoy los reclamos de las personas sobre sus datos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Abogado externo" id="id-e-9154">
      <documentation>Apoya a Jurídica por horas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Coordinador de TI" id="id-e-9155">
      <documentation>Administra servidores y accesos; puede consultar los diccionarios de S1, S3 y S4.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Proveedor del CRM (S2)" id="id-e-9156">
      <documentation>Actor externo. Puede entregar una consulta de solo lectura sobre la estructura de S2 si se le pide.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Servicio al cliente" id="id-e-9157">
      <documentation>Área de 3 personas que atiende llamadas, quejas y solicitudes; apoya los reclamos de titulares.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Oficial de protección de datos" id="id-e-9158">
      <documentation>Rol por designar (la gerente aún no lo decide): mantener políticas, atender reclamos, vigilar el cumplimiento y ser contacto con la autoridad. Quién lo ocupará está por definir.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Responsable de dato de área" id="id-e-9159">
      <documentation>Rol por designar: conocer, definir y vigilar la calidad de los datos de su área. Si será un cargo, una persona o un área está por definir.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Nueva fuente de datos incorporada" id="id-e-9176">
      <documentation>Se incorpora un sistema o fuente que maneja datos de personas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Cambio de estructura en una base de datos" id="id-e-9177">
      <documentation>Un proveedor o TI modifica tablas o columnas, hoy sin aviso formal.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Reclamo o solicitud de un titular" id="id-e-9178">
      <documentation>Una persona consulta, corrige o pide suprimir sus datos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Requerimiento de la SIC" id="id-e-9179">
      <documentation>La autoridad solicita información o el plazo de reporte se cumple. La obligación concreta está por verificar.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Candidato aprobado" id="id-e-9184">
      <documentation>Regla: un arriendo no se firma sin estudio aprobado.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Contrato de arrendamiento firmado" id="id-e-9185">
      <documentation>Nacen los datos de las partes, que hoy se digitan de nuevo en S1.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Vencimiento o terminación del contrato" id="id-e-9186">
      <documentation>Da paso al cierre: acta de entrega y devolución de depósitos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gobierno E2E del dato personal (de la fuente al reporte)" id="id-merge-6bf17d19b97a412493561a8efd5fa60e">
      <documentation>Origen del diseño: proceso E2E propuesto en la Fase 1 (V3).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Identificar fuentes y gestionar acceso a sus metadatos" id="id-merge-e735793d29b0448799ffa01c31ec99e1" />
    <element xsi:type="archimate:BusinessProcess" name="Importar metadatos técnicos" id="id-merge-30944ef7c19e4aef9026ffa665d85f18" />
    <element xsi:type="archimate:BusinessProcess" name="Inventariar atributos de negocio" id="id-merge-f8d6a6a7bb1641969d5bef19dade3c02" />
    <element xsi:type="archimate:BusinessProcess" name="Describir atributos (definición, responsable, calidad y validación)" id="id-merge-e14298b382da4ba187175ea72b68f694" />
    <element xsi:type="archimate:BusinessProcess" name="Clasificar atributos por categoría legal" id="id-merge-3e88bd860c1a46e4ae548790900fd8c1" />
    <element xsi:type="archimate:BusinessProcess" name="Validar jurídicamente la clasificación" id="id-merge-45421747bbd8417585ebecc809d6e4f4" />
    <element xsi:type="archimate:BusinessProcess" name="Publicar diccionario de datos y catálogo de términos" id="id-merge-5443b80439d248bbaeeac58d072faca3" />
    <element xsi:type="archimate:BusinessProcess" name="Controlar cambios de estructura" id="id-merge-65f65e8af0504ae89885219906d5f356" />
    <element xsi:type="archimate:BusinessProcess" name="Consultar y reportar (titulares, seguridad, SIC)" id="id-merge-e16727d298744f429b9a00fb41f1c63b" />
    <element xsi:type="archimate:BusinessActor" name="Gerente general" id="id-merge-93238d1ce6494749b0621d48b978af2d">
      <documentation>Aprueba políticas y asigna recursos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Director comercial" id="id-merge-54e5e9b1931844ce8c85df9892ed60ef">
      <documentation>Autoriza el acceso a la estructura de S2 (con visto bueno de la gerente).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Jefa de administración de arrendamientos" id="id-merge-51e705e5266b4367a6f1ad6acb575fdb">
      <documentation>Autoriza el acceso a la estructura de S1.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Contador" id="id-merge-b75a47c1d0744b96a85f385094a6e04a">
      <documentation>Autoriza el acceso a la estructura de S3.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Analista de mercadeo" id="id-merge-fba51ad7a5864bf4be347cfb524c6864">
      <documentation>Autoriza, con la gerente, el acceso a la estructura de S4.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Abogada interna" id="id-merge-cad61d8347e3416caa2f197a54fc3b0d">
      <documentation>Hoy atiende de forma informal los reclamos sobre datos y revisa clasificaciones.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Abogado externo" id="id-merge-b9312c631fc14f61bb8ef58e3445cbfe">
      <documentation>Apoya a Jurídica por horas; ayudaría con el reporte a la SIC.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Coordinador de TI" id="id-merge-1d69e8210dd74471a5ff3733a136ee4d">
      <documentation>Ejecuta el acceso a S1, S3 y S4; cumple parcialmente la función de seguridad.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Proveedor del CRM (S2)" id="id-merge-f329ddffce864930837131e707057f85">
      <documentation>Externo. Entrega la estructura de S2; la empresa no tiene credenciales propias.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Proveedores de software de S1 a S4" id="id-merge-694fe1e827d44c1fbf0ac81a291b6204">
      <documentation>Externos. Mantienen los sistemas y cambian estructuras, hoy sin aviso garantizado.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Superintendencia de Industria y Comercio (SIC)" id="id-merge-6910e2d25cbb49148f60f31b18f71998">
      <documentation>Autoridad de protección de datos. Obligación de reporte de la empresa por verificar.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Oficial de protección de datos" id="id-merge-0e3c9718f31d4d908e1b2b4e93c47ba7">
      <documentation>Rol por designar. Hoy lo cumple informalmente la abogada.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Responsable de dato de área" id="id-merge-e3ec0d2f54bd4dd5ab233f7238fa4990">
      <documentation>Rol por designar: conoce, define y vigila los datos de su área.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Administrador del diccionario de datos" id="id-merge-3fe4ec0f1c374541a10ba2d0f8a776f8">
      <documentation>Rol por designar. La entrevista habla de 'quien administre el diccionario' sin definirlo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Atributo de negocio" id="id-merge-956dbcb9f78241b88c70c3a5f3adc8cd" />
    <element xsi:type="archimate:BusinessObject" name="Metadato técnico" id="id-merge-a11be8df7cf644d2a6f946e82ed1601b" />
    <element xsi:type="archimate:BusinessObject" name="Metadato de negocio" id="id-merge-9a083dd1b7ab45999d0f12bb842b00e9" />
    <element xsi:type="archimate:BusinessObject" name="Fuente de datos" id="id-merge-b6cf72446dc34073995a12b4bd24629e" />
    <element xsi:type="archimate:BusinessObject" name="Clasificación del atributo" id="id-merge-7e3dbf0203e24705b1f1a54036f9d295" />
    <element xsi:type="archimate:BusinessObject" name="Término de negocio" id="id-merge-2d517609f4c84a5ca9aecee08c43ab82" />
    <element xsi:type="archimate:BusinessObject" name="Responsabilidad sobre el dato" id="id-merge-4653900f6d53496fbe2d02fe9666bac5" />
    <element xsi:type="archimate:BusinessObject" name="Cambio de estructura" id="id-merge-bb2c144d22134aea8d8b1e72fee9bac7" />
    <element xsi:type="archimate:BusinessObject" name="Evidencia de decisión" id="id-merge-c39a4f5ddc4940acae2f07a5613813e8" />
    <element xsi:type="archimate:BusinessObject" name="Informe regulatorio" id="id-merge-e5d4289857d64556a00294dcb706059d" />
    <element xsi:type="archimate:BusinessObject" name="Aviso" id="id-merge-90877cf8498f4539ae595a4198a1d8db" />
    <element xsi:type="archimate:BusinessObject" name="Autorización de acceso a metadatos" id="id-merge-40347801f1464d4b8e2de184262c9d0e" />
    <element xsi:type="archimate:BusinessObject" name="Diccionario de datos" id="id-merge-6276cc423ecc4ca08bf608cfe7d13611" />
    <element xsi:type="archimate:BusinessObject" name="Permiso de acceso" id="id-merge-12613a7c27284e26bec6ebdc9748f0f8" />
    <element xsi:type="archimate:BusinessService" name="Servicio de gobierno del dato personal" id="id-merge-949264a6700340838416d79990c1bb78">
      <documentation>El proceso E2E expuesto como un solo servicio al negocio: entrega un diccionario y un catálogo gobernados, con responsable y evidencia por atributo. Agrupa; no se implementa por separado.</documentation>
      <property key="Capa" value="1 - Servicio E2E" />
      <property key="Decisión" value="Incluido como agrupador (no se implementa por separado)" />
      <property key="Justificación" value="El proceso E2E expuesto como un solo servicio al negocio: entrega un diccionario y un catálogo gobernados, con responsable y evidencia por atributo. Agrupa; no se implementa por separado." />
      <property key="Capacidad soportada (V2)" value="Gobierno de Datos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de conocimiento de los datos" id="id-merge-4e5237166ada48869f85baf3a95435d0">
      <documentation>Etapa 'Conocer los datos': saber qué fuentes y atributos existen. Agrupa los servicios de actividad 1 a 3.</documentation>
      <property key="Capa" value="2 - Servicio de proceso" />
      <property key="Decisión" value="Incluido como agrupador (no se implementa por separado)" />
      <property key="Justificación" value="Etapa 'Conocer los datos': saber qué fuentes y atributos existen. Agrupa los servicios de actividad 1 a 3." />
      <property key="Capacidad soportada (V2)" value="Gestión de Metadatos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de descripción de los datos" id="id-merge-f310140a86094285981260354b59f8b0">
      <documentation>Etapa 'Describir los datos': definición, responsable y calidad por atributo. Agrupa los servicios 4 y 5.</documentation>
      <property key="Capa" value="2 - Servicio de proceso" />
      <property key="Decisión" value="Incluido como agrupador (no se implementa por separado)" />
      <property key="Justificación" value="Etapa 'Describir los datos': definición, responsable y calidad por atributo. Agrupa los servicios 4 y 5." />
      <property key="Capacidad soportada (V2)" value="Gestión de Metadatos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de clasificación de los datos" id="id-merge-0feb41212d8644838701410bbc49509c">
      <documentation>Etapa 'Clasificar los datos': categoría legal con validación jurídica. Agrupa los servicios 6 y 7.</documentation>
      <property key="Capa" value="2 - Servicio de proceso" />
      <property key="Decisión" value="Incluido como agrupador (no se implementa por separado)" />
      <property key="Justificación" value="Etapa 'Clasificar los datos': categoría legal con validación jurídica. Agrupa los servicios 6 y 7." />
      <property key="Capacidad soportada (V2)" value="Clasificación de Datos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de publicación y mantenimiento del diccionario" id="id-merge-27d74dd50d364370a0d68d8af99e2cd3">
      <documentation>Etapa 'Publicar y mantener': integrar el diccionario, el catálogo y los cambios. Agrupa los servicios 8 a 10.</documentation>
      <property key="Capa" value="2 - Servicio de proceso" />
      <property key="Decisión" value="Incluido como agrupador (no se implementa por separado)" />
      <property key="Justificación" value="Etapa 'Publicar y mantener': integrar el diccionario, el catálogo y los cambios. Agrupa los servicios 8 a 10." />
      <property key="Capacidad soportada (V2)" value="Gestión de Metadatos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de uso y rendición de cuentas" id="id-merge-e87543f1574948b898ae71610fdb6d2d">
      <documentation>Etapa 'Usar y rendir cuentas': titulares, seguridad, reporte y seguimiento. Agrupa los servicios 11 a 14.</documentation>
      <property key="Capa" value="2 - Servicio de proceso" />
      <property key="Decisión" value="Incluido como agrupador (no se implementa por separado)" />
      <property key="Justificación" value="Etapa 'Usar y rendir cuentas': titulares, seguridad, reporte y seguimiento. Agrupa los servicios 11 a 14." />
      <property key="Capacidad soportada (V2)" value="Gestión de la protección de datos personales" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de gestión del acceso a metadatos técnicos" id="id-merge-13abce6151bf4185a844352a8a102d1c">
      <documentation>Sin acceso autorizado, de solo lectura y con constancia, no se puede importar nada. Lo exige el negocio (Bloque 8).</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Sin acceso autorizado, de solo lectura y con constancia, no se puede importar nada. Lo exige el negocio (Bloque 8)." />
      <property key="Capacidad soportada (V2)" value="Gestión de metadatos técnicos" />
      <property key="Consumidores" value="Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de importación de metadatos técnicos" id="id-merge-df231525b0a346909f043de099c47761">
      <documentation>Alcance 3: traer tipo y longitud de los motores. Evita digitar a mano ~1.850 columnas.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Alcance 3: traer tipo y longitud de los motores. Evita digitar a mano ~1.850 columnas." />
      <property key="Capacidad soportada (V2)" value="Gestión de metadatos técnicos" />
      <property key="Consumidores" value="Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de inventario de atributos de negocio" id="id-merge-758a417576bd43fc9bb9f8f31d17ea61">
      <documentation>Consolida columnas técnicas y fuentes manuales en atributos de negocio (se estiman 600 a 800).</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Consolida columnas técnicas y fuentes manuales en atributos de negocio (se estiman 600 a 800)." />
      <property key="Capacidad soportada (V2)" value="Inventario de atributos de negocio" />
      <property key="Consumidores" value="Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de registro de metadatos de negocio" id="id-merge-591f49b5421a448782abec5fa8e58e99">
      <documentation>Alcance 2: definición, responsable, calidad y expresión regular por atributo.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Alcance 2: definición, responsable, calidad y expresión regular por atributo." />
      <property key="Capacidad soportada (V2)" value="Gestión de metadatos de negocio" />
      <property key="Consumidores" value="Responsable de dato de área" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de asignación de responsables de datos" id="id-merge-704e234c129b49e19d96569be3cb6efe">
      <documentation>Hoy ningún dato tiene dueño. Cierra el 'eso es de otra área'.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Hoy ningún dato tiene dueño. Cierra el 'eso es de otra área'." />
      <property key="Capacidad soportada (V2)" value="Gestión de responsables de datos" />
      <property key="Consumidores" value="Administrador del diccionario; Gerente general" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de clasificación de atributos" id="id-merge-8ed8636596d545789b917c8e4ceaf6e3">
      <documentation>Alcance 1: asignar categoría con criterio y justificación; estado 'en revisión' si hay discusión.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Alcance 1: asignar categoría con criterio y justificación; estado 'en revisión' si hay discusión." />
      <property key="Capacidad soportada (V2)" value="Clasificación de atributos por categoría legal" />
      <property key="Consumidores" value="Oficial de protección de datos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de validación jurídica de la clasificación" id="id-merge-106f0e856438407f90dc420e950af142">
      <documentation>Jurídica revisa y deja constancia. La herramienta registra la decisión; el criterio es humano (incluido parcialmente).</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido parcialmente" />
      <property key="Justificación" value="Jurídica revisa y deja constancia. La herramienta registra la decisión; el criterio es humano (incluido parcialmente)." />
      <property key="Capacidad soportada (V2)" value="Validación jurídica de la clasificación" />
      <property key="Consumidores" value="Abogada interna; Oficial de protección de datos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de publicación del diccionario de datos" id="id-merge-9fb96d9ada694333923139d4c36e527d">
      <documentation>Alcance 4: diccionario que integra lo técnico y lo de negocio por atributo.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Alcance 4: diccionario que integra lo técnico y lo de negocio por atributo." />
      <property key="Capacidad soportada (V2)" value="Gestión del diccionario de datos" />
      <property key="Consumidores" value="Todos los roles con permiso de consulta" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de gestión del catálogo de términos de negocio" id="id-merge-6ec4f72e39284d39bb92555ec7fa6958">
      <documentation>Alcance 5: resuelve términos con significados distintos como 'activo' o 'canon'.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Alcance 5: resuelve términos con significados distintos como 'activo' o 'canon'." />
      <property key="Capacidad soportada (V2)" value="Gestión del catálogo de términos de negocio" />
      <property key="Consumidores" value="Responsable de dato de área; Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de control de cambios de estructura" id="id-merge-5e63adeffff0421c82ee7acad8eb767b">
      <documentation>Los proveedores cambian estructuras sin aviso; el diccionario debe reflejarlo.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Los proveedores cambian estructuras sin aviso; el diccionario debe reflejarlo." />
      <property key="Capacidad soportada (V2)" value="Gestión de cambios de estructura de datos" />
      <property key="Consumidores" value="Coordinador de TI; Administrador del diccionario" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de ubicación de datos personales" id="id-merge-b313d3cc455640839c986af75064f45b">
      <documentation>Responde 'dónde están los datos de esta persona': atributos, categoría, sistema y responsable.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Responde 'dónde están los datos de esta persona': atributos, categoría, sistema y responsable." />
      <property key="Capacidad soportada (V2)" value="Atención de derechos de los titulares" />
      <property key="Consumidores" value="Oficial de protección de datos" />
    </element>
    <element xsi:type="archimate:BusinessService" name="Servicio de información para seguridad de la información" id="id-merge-f70cd868ac9b42d2824f95d920dcb323">
      <documentation>Entrega a TI los atributos sensibles y privados, sistemas de mayor riesgo y cambios que los afecten.</documentation>
      <property key="Capa" value="3 - Servicio de actividad" />
      <property key="Decisión" value="Incluido" />
      <property key="Justificación" value="Entrega a TI los atributos sensibles y privados, sistemas de mayor riesgo y cambios que los afecten." />
      <property key="Capacidad soportada (V2)" value="Gestión de la seguridad de la información" />
      <property key="Consumidores" value="Coordinador de TI" />
