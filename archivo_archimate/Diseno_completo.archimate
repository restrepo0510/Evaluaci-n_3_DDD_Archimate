      <documentation>La clasificación mide el valor dentro de la solución: Core es lo que cumple conocer, clasificar o describir los datos.</documentation>
      <property key="Subdominios Core" value="Atributos de negocio y su descripción; Clasificación y validación jurídica; Diccionario integrado" />
      <property key="Criterio de clasificación" value="Valor dentro de la solución: Core si cumple conocer, clasificar o describir los datos. No es el valor para el negocio inmobiliario" />
      <property key="Cantidad de subdominios" value="8" />
    </element>
