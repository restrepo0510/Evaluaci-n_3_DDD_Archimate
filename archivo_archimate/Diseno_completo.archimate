    <element xsi:type="archimate:RealizationRelationship" id="id-7426aa6b6bd14079a65edbb053fed127" source="id-347b47bccb864d8a90babb3238a4c656" target="id-2c470d1211e04ec599f15fc059f63c40" />
    <element xsi:type="archimate:AssociationRelationship" name="comandos" id="id-9b823a48af084f5dacb3881eabffdb2a" source="id-41ed665b1e67410cbbecf25360f07331" target="id-347b47bccb864d8a90babb3238a4c656">
      <documentation>Comandos de la V6.b por pantalla, sin adaptador: Registrar atributo de negocio; Actualizar metadato de negocio; Registrar política de calidad; Validar sintaxis de expresión regular.</documentation>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="comandos" id="id-11e3b93a9632406aa7fb0c0f0191aa75" source="id-db5effa4768d42db92557e18cacd5b74" target="id-347b47bccb864d8a90babb3238a4c656">
      <documentation>Comandos de la V6.b por pantalla, sin adaptador.</documentation>
    </element>
    <element xsi:type="archimate:FlowRelationship" name="carga (A4)" id="id-0ebc35c2c86c49a1ba3768f42e843053" source="id-08db0a6a6e824545ae0e3522f35091e2" target="id-347b47bccb864d8a90babb3238a4c656">
      <documentation>Carga de inventario con plantilla por el adaptador A4 (capa anticorrupción). Se rechazan las filas cuya fuente no existe en C1 y los archivos con datos de personas.</documentation>
    </element>
    <element xsi:type="archimate:ServingRelationship" name="servicio abierto" id="id-2232a68cd2674e67a8085baeeb0f1c65" source="id-21911b0025d14a748b3f4c337b609a1b" target="id-347b47bccb864d8a90babb3238a4c656">
      <documentation>Relación 2 de la V8: servicio abierto + lenguaje publicado; C2 conformista. C2 consulta consultarFuente para validar que la fuente exista.</documentation>
    </element>
    <element xsi:type="archimate:FlowRelationship" name="evento" id="id-70cecee8876f435abb2067cf6548be68" source="id-21911b0025d14a748b3f4c337b609a1b" target="id-347b47bccb864d8a90babb3238a4c656">
      <documentation>Evento "Fuente registrada", para mantener una copia local de las identidades de fuente en C2.</documentation>
    </element>
    <element xsi:type="archimate:ServingRelationship" name="servicio abierto" id="id-11ff284d594343988286f57911f8e585" source="id-347b47bccb864d8a90babb3238a4c656" target="id-c1b70395a77644a29aee9f8aaa818738">
      <documentation>Relación 4 de la V8: servicio abierto + lenguaje publicado de C2; C4 conformista. consultarAtributo(id).</documentation>
    </element>
    <element xsi:type="archimate:FlowRelationship" name="evento" id="id-7f569aa7b49349cdbb868c06d63a3b40" source="id-347b47bccb864d8a90babb3238a4c656" target="id-c1b70395a77644a29aee9f8aaa818738">
      <documentation>Relación 8 de la V8 (inferencia por confirmar): evento "Metadato de negocio actualizado". Cliente-proveedor, C2 proveedor y C4 cliente.</documentation>
    </element>
    <element xsi:type="archimate:FlowRelationship" name="eventos" id="id-55b9a720eb214db4a1b3a65754b0d7c0" source="id-347b47bccb864d8a90babb3238a4c656" target="id-7135a39e40b64504b57fe47d19255cc9">
      <documentation>Relación 10 de la V8: eventos "Atributo de negocio registrado" y "Metadato de negocio actualizado". Lenguaje publicado; C6 conformista.</documentation>
    </element>
    <element xsi:type="archimate:ServingRelationship" name="servicio abierto" id="id-bb3e75c8cc8c4d1e99a754d3c1a4faef" source="id-347b47bccb864d8a90babb3238a4c656" target="id-a3a07039056f46c18f1c4a8ca69dca7c">
      <documentation>Relación 3 de la V8: servicio abierto + lenguaje publicado de C2; C3 conformista. consultarAtributo(id).</documentation>
    </element>
    <element xsi:type="archimate:ServingRelationship" name="servicio abierto" id="id-d1e39846d4a74d3f92da10dfecc2f590" source="id-347b47bccb864d8a90babb3238a4c656" target="id-8d5561fce18e405286bf5f6060296a7f">
      <documentation>Relación 5 de la V8: servicio abierto + lenguaje publicado de C2; C5 conformista. consultarAtributo(id).</documentation>
    </element>
  </folder>
