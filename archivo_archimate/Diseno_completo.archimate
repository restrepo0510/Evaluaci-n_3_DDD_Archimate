    <element xsi:type="archimate:DataObject" name="Estado de completitud" id="id-150dd23a4b7441408aea144e8bd02e66">
      <documentation>Indicador derivado que permite reconocer si el atributo tiene la información mínima necesaria para considerarse completo.</documentation>
    </element>
